import { useEffect, useState } from 'react';

const SEEN_KEY = 'rc_intro_seen';

export default function IntroSplash() {
    const [show, setShow] = useState(() => {
        try { return sessionStorage.getItem(SEEN_KEY) !== '1'; } catch (e) { return true; }
    });
    const [leaving, setLeaving] = useState(false);

    const finish = () => {
        try { sessionStorage.setItem(SEEN_KEY, '1'); } catch (e) {}
        setShow(false);
    };

    useEffect(() => {
        if (!show) return undefined;
        const t1 = setTimeout(() => setLeaving(true), 4300);
        const t2 = setTimeout(finish, 5000);
        return () => { clearTimeout(t1); clearTimeout(t2); };
    }, [show]);

    const skip = () => {
        setLeaving(true);
        setTimeout(finish, 500);
    };

    if (!show) return null;

    return (
        <div className={'rc-intro' + (leaving ? ' rc-leave' : '')} role="presentation">
            <style>{`
                .rc-intro{position:fixed;inset:0;z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px;background:radial-gradient(circle at 50% 35%,#dc2626 0%,#b91c1c 55%,#7f1d1d 100%);color:#fff;font-family:'Montserrat','Open Sans',sans-serif;opacity:1;transition:opacity .7s ease;overflow:hidden}
                .rc-leave{opacity:0;pointer-events:none}
                .rc-wrap{position:relative;width:120px;height:120px;margin-bottom:30px}
                .rc-drop{position:absolute;left:50%;top:50%;width:14px;height:14px;margin:-7px 0 0 -7px;border-radius:50%;background:#fff;opacity:0;animation:rcDrop .7s cubic-bezier(.5,0,1,.5) .2s forwards}
                .rc-rp{position:absolute;inset:0;border-radius:50%;border:2px solid rgba(255,255,255,.7);opacity:0;animation:rcRp 1.6s ease-out forwards}
                .rc-rp:nth-child(2){animation-delay:.9s}
                .rc-rp:nth-child(3){animation-delay:1.2s}
                .rc-rp:nth-child(4){animation-delay:1.5s}
                .rc-logo{position:absolute;inset:0;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 30px rgba(0,0,0,.3);animation:rcPop .6s cubic-bezier(.34,1.56,.64,1) 1s both}
                .rc-logo img{width:78px;height:78px;object-fit:contain}
                .rc-text{font-size:26px;font-weight:600;line-height:1.35;max-width:320px;opacity:0;animation:rcUp .8s ease 1.9s both}
                .rc-skip{position:absolute;top:16px;right:16px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.4);color:#fff;border-radius:999px;padding:6px 14px;font-size:12px;cursor:pointer;font-family:inherit}
                @keyframes rcDrop{0%{opacity:1;transform:translateY(-60vh)}90%{opacity:1;transform:translateY(0)}100%{opacity:0;transform:scale(.2)}}
                @keyframes rcRp{0%{opacity:.9;transform:scale(.2)}100%{opacity:0;transform:scale(5)}}
                @keyframes rcPop{from{opacity:0;transform:scale(.2)}to{opacity:1;transform:none}}
                @keyframes rcUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
                @media (prefers-reduced-motion: reduce){.rc-intro *{animation-duration:.01ms !important;animation-delay:0s !important}}
            `}</style>
            <div className="rc-wrap">
                <span className="rc-drop" />
                <span className="rc-rp" /><span className="rc-rp" /><span className="rc-rp" />
                <div className="rc-logo"><img src="/images/red-cross-logo.png" alt="Philippine Red Cross" /></div>
            </div>
            <div className="rc-text">Thank you for choosing to serve.</div>
            <button type="button" className="rc-skip" onClick={skip}>Skip</button>
        </div>
    );
}
