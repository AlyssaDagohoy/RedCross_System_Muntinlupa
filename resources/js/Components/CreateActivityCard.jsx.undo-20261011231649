import { Link } from '@inertiajs/react';

export default function CreateActivityCard() {
    const lift = (e, y) => { e.currentTarget.style.transform = `translateY(${y}px)`; };
    return (
        <div style={{ margin: 0, background: '#B92F2F', borderRadius: 12, padding: 14, display: 'flex', flexDirection: 'column', gap: 8 }}>
            <span style={{ color: '#F7C1C1', fontSize: 12 }}>Next activity</span>
            <span style={{ color: '#fff', fontSize: 15, fontWeight: 500, lineHeight: 1.3 }}>Plan a new event for your volunteers</span>
            <Link
                href={route('admin.activities.create')}
                onMouseEnter={(e) => lift(e, -2)}
                onMouseLeave={(e) => lift(e, 0)}
                style={{ alignSelf: 'flex-start', display: 'inline-flex', alignItems: 'center', gap: 6, background: '#fff', color: '#B92F2F', fontSize: 13, fontWeight: 500, padding: '7px 14px', borderRadius: 999, textDecoration: 'none', transition: 'transform .15s' }}
            >
                <span style={{ fontSize: 16, lineHeight: 1 }}>+</span> Create
            </Link>
        </div>
    );
}