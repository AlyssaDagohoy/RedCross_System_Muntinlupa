import { useEffect, useRef, useState } from 'react';
import { router } from '@inertiajs/react';

const href = (name, fallback) => {
    try { return typeof route === 'function' ? route(name) : fallback; } catch (e) { return fallback; }
};

export default function IntroSplash({ authed = false }) {
    const [show, setShow] = useState(!authed);
    const [go, setGo] = useState(false);
    const [fly, setFly] = useState(null);
    const [soft, setSoft] = useState(false);
    const wrapRef = useRef(null);
    const busy = useRef(false);

    useEffect(() => {
        if (!show) return undefined;
        const prev = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        return () => { document.body.style.overflow = prev; };
    }, [show]);

    const findTarget = () => {
        const imgs = Array.from(document.querySelectorAll('img[alt="Philippine Red Cross"]'));
        const img = imgs.find((i) => !i.closest('.rc-intro'));
        return img ? img.parentElement : null;
    };

    const land = () => {
        setTimeout(() => {
            const target = findTarget();
            if (!target) {
                setGo(true);
                setTimeout(() => setShow(false), 1000);
                return;
            }
            const r = target.getBoundingClientRect();
            target.style.transition = 'none';
            target.style.opacity = '0';
            setGo(true);
            setFly((f) => (f ? { ...f, to: { left: r.left, top: r.top, size: r.width }, end: true } : f));
            setTimeout(() => {
                target.style.transition = 'opacity .5s ease';
                target.style.opacity = '1';
                setSoft(true);
            }, 1250);
            setTimeout(() => {
                target.style.transition = '';
                setShow(false);
            }, 1850);
        }, 120);
    };

    const proceed = () => {
        if (busy.current) return;
        busy.current = true;
        const box = wrapRef.current ? wrapRef.current.getBoundingClientRect() : null;
        if (box) setFly({ from: { left: box.left, top: box.top, size: box.width }, end: false });
        let path = '/login';
        let same = false;
        try {
            const u = new URL(href('login', '/login'), window.location.origin);
            path = u.pathname + u.search;
            same = u.pathname === window.location.pathname;
        } catch (err) {}
        if (same) { land(); return; }
        router.visit(path, { onFinish: land });
    };

    const onKey = (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); proceed(); } };

    if (!show) return null;

    const pos = fly ? (fly.end && fly.to ? fly.to : fly.from) : null;

    return (
        <div className={'rc-intro' + (go ? ' rc-go' : '') + (fly ? ' rc-fly-on' : '')}>
            <style>{`
                .rc-intro{position:fixed;inset:0;z-index:9999;overflow:hidden;font-family:'Montserrat','Open Sans',sans-serif}
                .rc-go{pointer-events:none}
                .rc-lay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px}
                .rc-red{background:#b91c1c;color:#fff;z-index:2;cursor:pointer;outline:none;transition:opacity .7s ease .15s}
                .rc-go .rc-red{opacity:0;cursor:default}
                .rc-wrap{position:relative;width:120px;height:120px;margin-bottom:30px}
                .rc-drop{position:absolute;left:50%;top:50%;width:16px;height:16px;margin:-8px 0 0 -8px;border-radius:50%;background:#fff;opacity:0;animation:rcDrop .7s cubic-bezier(.5,0,1,.5) .2s forwards}
                .rc-rp{position:absolute;inset:0;border-radius:50%;border:2px solid rgba(255,255,255,.75);opacity:0;animation:rcRp 1.6s ease-out .9s forwards}
                .rc-rp:nth-child(3){animation-delay:1.2s}
                .rc-rp:nth-child(4){animation-delay:1.5s}
                .rc-logo{position:absolute;inset:0;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 30px rgba(0,0,0,.3);opacity:0;animation:rcPop .6s cubic-bezier(.34,1.56,.64,1) 1s forwards}
                .rc-logo img{width:112px;height:112px;object-fit:contain;transform:translate(2px,0px)}
                .rc-fly-on .rc-logo,.rc-fly-on .rc-rp,.rc-fly-on .rc-drop{visibility:hidden}
                .rc-text{font-size:26px;font-weight:500;line-height:1.4;opacity:0;animation:rcUp .8s ease 1.9s forwards}
                .rc-tap{position:absolute;bottom:36px;left:0;right:0;font-size:12px;letter-spacing:.2em;text-transform:uppercase;opacity:0;animation:rcFi .6s ease 2.8s forwards,rcPu 1.6s ease-in-out 3.4s infinite}
                .rc-go .rc-tap{animation:none;opacity:0}
                .rc-fly{position:absolute;z-index:3;box-sizing:border-box;border-radius:50%;background:#fff;border:1px solid #fff;overflow:hidden;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 30px rgba(0,0,0,.3);transition:left 1.2s cubic-bezier(.22,1,.36,1),top 1.2s cubic-bezier(.22,1,.36,1),width 1.2s cubic-bezier(.22,1,.36,1),height 1.2s cubic-bezier(.22,1,.36,1),box-shadow 1.2s ease,border-color 1.2s ease}
                .rc-fly img{width:93%;height:93%;object-fit:contain;transform:translate(2px,0px);transition:width 1.2s cubic-bezier(.22,1,.36,1),height 1.2s cubic-bezier(.22,1,.36,1),transform 1.2s cubic-bezier(.22,1,.36,1)}
                .rc-fly.rc-end{border-color:#ffe2e2;box-shadow:0 6px 18px rgba(127,29,29,.14)}
                .rc-fly.rc-end img{width:100%;height:100%;transform:none}
                .rc-fly.rc-soft{opacity:0;transition:opacity .5s ease}
                @keyframes rcDrop{0%{opacity:1;transform:translateY(-45vh)}90%{opacity:1;transform:none}100%{opacity:0;transform:scale(.2)}}
                @keyframes rcRp{0%{opacity:.9;transform:scale(.2)}100%{opacity:0;transform:scale(5)}}
                @keyframes rcPop{from{opacity:0;transform:scale(.2)}to{opacity:1;transform:none}}
                @keyframes rcUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
                @keyframes rcFi{to{opacity:1}}
                @keyframes rcPu{0%,100%{opacity:1}50%{opacity:.45}}
                @media (prefers-reduced-motion: reduce){.rc-intro *{animation-duration:.01ms !important;animation-delay:0s !important;transition-duration:.01ms !important}}
            `}</style>
            <div className="rc-lay rc-red" role="button" tabIndex={go ? -1 : 0} aria-label="Tap to continue" onClick={proceed} onKeyDown={onKey}>
                <div className="rc-wrap" ref={wrapRef}>
                    <span className="rc-drop" />
                    <span className="rc-rp" /><span className="rc-rp" /><span className="rc-rp" />
                    <div className="rc-logo"><img src="/images/red-cross-logo.png" alt="Philippine Red Cross" /></div>
                </div>
                <div className="rc-text">Thank you for<br />choosing to serve!</div>
                <div className="rc-tap">Tap to continue</div>
            </div>
            {fly && pos && (
                <div className={'rc-fly' + (fly.end ? ' rc-end' : '') + (soft ? ' rc-soft' : '')} style={{ left: pos.left, top: pos.top, width: pos.size, height: pos.size }}>
                    <img src="/images/red-cross-logo.png" alt="" />
                </div>
            )}
        </div>
    );
}
