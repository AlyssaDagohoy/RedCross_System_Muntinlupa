import { useEffect, useState } from 'react';

const SEEN_KEY = 'rc_intro_seen';

export default function IntroSplash() {
    const [show, setShow] = useState(() => {
        try { return sessionStorage.getItem(SEEN_KEY) !== '1'; } catch (e) { return true; }
    });
    const [leaving, setLeaving] = useState(false);

    const finish = () => {
        try { sessionStorage.setItem(SEEN_KEY, '1'); } catch (e) {}
        setShow(false);
    };

    useEffect(() => {
        if (!show) return undefined;
        const t1 = setTimeout(() => setLeaving(true), 5600);
        const t2 = setTimeout(finish, 6300);
        return () => { clearTimeout(t1); clearTimeout(t2); };
    }, [show]);

    const skip = () => {
        setLeaving(true);
        setTimeout(finish, 500);
    };

    if (!show) return null;

    return (
        <div className={'rc-intro' + (leaving ? ' rc-leave' : '')} role="presentation">
            <style>{`
                .rc-intro{position:fixed;inset:0;z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px;background:radial-gradient(circle at 50% 35%,#dc2626 0%,#b91c1c 55%,#7f1d1d 100%);color:#fff;font-family:'Montserrat','Open Sans',sans-serif;opacity:1;transition:opacity .7s ease;overflow:hidden}
                .rc-leave{opacity:0;pointer-events:none}
                .rc-logo-wrap{position:relative;width:120px;height:120px;margin-bottom:28px}
                .rc-ring{position:absolute;inset:0;border-radius:50%;border:2px solid rgba(255,255,255,.55);opacity:0;animation:rcRing 2.4s ease-out infinite}
                .rc-ring:nth-child(1){animation-delay:.9s}
                .rc-ring:nth-child(2){animation-delay:1.7s}
                .rc-ring:nth-child(3){animation-delay:2.5s}
                .rc-logo{position:relative;width:120px;height:120px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 30px rgba(0,0,0,.3);animation:rcPop .9s cubic-bezier(.34,1.56,.64,1) .2s both}
                .rc-logo img{width:78px;height:78px;object-fit:contain}
                .rc-welcome{font-size:13px;letter-spacing:.3em;text-transform:uppercase;opacity:0;animation:rcUp .8s ease 1.3s both}
                .rc-title{font-family:'Oswald','Montserrat',sans-serif;font-size:40px;font-weight:700;margin-top:6px;opacity:0;animation:rcUp .8s ease 1.9s both}
                .rc-sub{font-size:14px;font-weight:500;color:rgba(255,255,255,.85);opacity:0;animation:rcUp .8s ease 2.4s both}
                .rc-tag{margin-top:26px;font-size:16px;font-weight:600;display:flex;gap:8px;flex-wrap:wrap;justify-content:center}
                .rc-tag span{opacity:0;animation:rcUp .7s ease both}
                .rc-tag span:nth-child(1){animation-delay:3.2s}
                .rc-tag span:nth-child(2){animation-delay:3.8s}
                .rc-tag span:nth-child(3){animation-delay:4.4s;color:#ffe4e6;text-decoration:underline;text-underline-offset:4px}
                .rc-bar{position:absolute;left:0;right:0;bottom:0;height:4px;background:rgba(255,255,255,.2)}
                .rc-bar i{display:block;height:100%;background:#fff;width:0;animation:rcBar 5.6s linear forwards}
                .rc-skip{position:absolute;top:16px;right:16px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.4);color:#fff;border-radius:999px;padding:6px 14px;font-size:12px;cursor:pointer;font-family:inherit}
                @keyframes rcPop{from{opacity:0;transform:scale(.2) rotate(-20deg)}to{opacity:1;transform:scale(1) rotate(0)}}
                @keyframes rcRing{0%{opacity:.8;transform:scale(1)}100%{opacity:0;transform:scale(2.4)}}
                @keyframes rcUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
                @keyframes rcBar{to{width:100%}}
                @media (prefers-reduced-motion: reduce){.rc-intro *{animation-duration:.01ms !important;animation-delay:0s !important}}
            `}</style>
            <div className="rc-logo-wrap">
                <span className="rc-ring" /><span className="rc-ring" /><span className="rc-ring" />
                <div className="rc-logo"><img src="/images/red-cross-logo.png" alt="Philippine Red Cross" /></div>
            </div>
            <div className="rc-welcome">Welcome to</div>
            <div className="rc-title">Rizal Chapter</div>
            <div className="rc-sub">Volunteer System</div>
            <div className="rc-tag"><span>Verified.</span><span>Trusted.</span><span>Ready to Serve.</span></div>
            <div className="rc-bar"><i /></div>
            <button type="button" className="rc-skip" onClick={skip}>Skip</button>
        </div>
    );
}
