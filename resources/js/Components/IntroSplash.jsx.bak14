import { useEffect, useState } from 'react';
import { router } from '@inertiajs/react';

const SEEN_KEY = 'rc_intro_seen';

const href = (name, fallback) => {
    try { return typeof route === 'function' ? route(name) : fallback; } catch (e) { return fallback; }
};

export default function IntroSplash({ authed = false }) {
    const [show, setShow] = useState(() => {
        if (authed) return false;
        try { return sessionStorage.getItem(SEEN_KEY) !== '1'; } catch (e) { return true; }
    });
    const [go, setGo] = useState(false);

    useEffect(() => {
        if (!show) return undefined;
        const prev = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        return () => { document.body.style.overflow = prev; };
    }, [show]);

    const proceed = () => { if (!go) setGo(true); };
    const onKey = (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); proceed(); } };
    const choose = (name, fallback) => (e) => {
        e.preventDefault();
        try { sessionStorage.setItem(SEEN_KEY, '1'); } catch (err) {}
        setShow(false);
        router.visit(href(name, fallback));
    };

    if (!show) return null;

    return (
        <div className={'rc-intro' + (go ? ' rc-go' : '')}>
            <style>{`
                .rc-intro{position:fixed;inset:0;z-index:9999;overflow:hidden;font-family:'Montserrat','Open Sans',sans-serif}
                .rc-lay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px}
                .rc-pink{background:#fdecec}
                .rc-red{background:#b91c1c;color:#fff;z-index:2;cursor:pointer;outline:none;transition:transform .9s cubic-bezier(.7,0,.2,1)}
                .rc-go .rc-red{transform:translateY(-101%);cursor:default;pointer-events:none}
                .rc-wrap{position:relative;width:120px;height:120px;margin-bottom:30px}
                .rc-drop{position:absolute;left:50%;top:50%;width:16px;height:16px;margin:-8px 0 0 -8px;border-radius:50%;background:#fff;opacity:0;animation:rcDrop .7s cubic-bezier(.5,0,1,.5) .2s forwards}
                .rc-rp{position:absolute;inset:0;border-radius:50%;border:2px solid rgba(255,255,255,.75);opacity:0;animation:rcRp 1.6s ease-out .9s forwards}
                .rc-rp:nth-child(3){animation-delay:1.2s}
                .rc-rp:nth-child(4){animation-delay:1.5s}
                .rc-logo{position:absolute;inset:0;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 30px rgba(0,0,0,.3);opacity:0;animation:rcPop .6s cubic-bezier(.34,1.56,.64,1) 1s forwards}
                .rc-logo img{width:112px;height:112px;object-fit:contain}
                .rc-text{font-size:26px;font-weight:500;line-height:1.4;opacity:0;animation:rcUp .8s ease 1.9s forwards}
                .rc-tap{position:absolute;bottom:36px;left:0;right:0;font-size:12px;letter-spacing:.2em;text-transform:uppercase;opacity:0;animation:rcFi .6s ease 2.8s forwards,rcPu 1.6s ease-in-out 3.4s infinite}
                .rc-go .rc-tap{animation:none;opacity:0}
                .rc-plogo{width:84px;height:84px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;margin-bottom:34px;box-shadow:0 8px 22px rgba(185,28,28,.25);opacity:0}
                .rc-plogo img{width:74px;height:74px;object-fit:contain}
                .rc-btn{display:block;width:min(260px,80vw);padding:14px 0;border-radius:999px;font-size:16px;font-weight:500;text-decoration:none;opacity:0;font-family:inherit}
                .rc-b1{background:#dc2626;color:#fff;margin-bottom:14px}
                .rc-b2{border:1.5px solid #dc2626;color:#b91c1c;padding:12.5px 0}
                .rc-go .rc-plogo{animation:rcPop .5s cubic-bezier(.34,1.56,.64,1) .6s forwards}
                .rc-go .rc-b1{animation:rcBp .6s cubic-bezier(.34,1.56,.64,1) .85s forwards}
                .rc-go .rc-b2{animation:rcBp .6s cubic-bezier(.34,1.56,.64,1) 1.1s forwards}
                .rc-logo img,.rc-plogo img{transform:translate(2px,0px)}
                @keyframes rcDrop{0%{opacity:1;transform:translateY(-45vh)}90%{opacity:1;transform:none}100%{opacity:0;transform:scale(.2)}}
                @keyframes rcRp{0%{opacity:.9;transform:scale(.2)}100%{opacity:0;transform:scale(5)}}
                @keyframes rcPop{from{opacity:0;transform:scale(.2)}to{opacity:1;transform:none}}
                @keyframes rcUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
                @keyframes rcFi{to{opacity:1}}
                @keyframes rcPu{0%,100%{opacity:1}50%{opacity:.45}}
                @keyframes rcBp{from{opacity:0;transform:translateY(34px) scale(.8)}to{opacity:1;transform:none}}
                @media (prefers-reduced-motion: reduce){.rc-intro *{animation-duration:.01ms !important;animation-delay:0s !important;transition-duration:.01ms !important}}
            `}</style>
            <div className="rc-lay rc-pink">
                <div className="rc-plogo"><img src="/images/red-cross-logo.png" alt="Philippine Red Cross" /></div>
                <a className="rc-btn rc-b1" href={href('login', '/login')} onClick={choose('login', '/login')} tabIndex={go ? 0 : -1}>Log In</a>
                <a className="rc-btn rc-b2" href={href('register', '/register')} onClick={choose('register', '/register')} tabIndex={go ? 0 : -1}>Sign Up</a>
            </div>
            <div className="rc-lay rc-red" role="button" tabIndex={go ? -1 : 0} aria-label="Tap to continue" onClick={proceed} onKeyDown={onKey}>
                <div className="rc-wrap">
                    <span className="rc-drop" />
                    <span className="rc-rp" /><span className="rc-rp" /><span className="rc-rp" />
                    <div className="rc-logo"><img src="/images/red-cross-logo.png" alt="Philippine Red Cross" /></div>
                </div>
                <div className="rc-text">Thank you for<br />choosing to serve!</div>
                <div className="rc-tap">Tap to continue</div>
            </div>
        </div>
    );
}
