import { router, useForm } from '@inertiajs/react';
import { useState } from 'react';
import VolunteerShell from '../../Components/VolunteerShell';

/* ------------------------------------------------------------------ */
/* 201 File — everything in one page:                                 */
/*  1. Approved (files the Red Cross gives you) + your own Folders     */
/*  2. Document Requests (from admin) — upload directly, no category   */
/*                                                                       */
/*  Files are never linked to directly. View/Download always go        */
/*  through a protected backend route (view/download by id) that       */
/*  checks the document belongs to the logged-in volunteer first.      */
/* ------------------------------------------------------------------ */

const DOC_REQUEST_STATUS = {
    pending_submission: { background: '#fffbeb', color: '#b45309', label: 'Pending Submission' },
    submitted:          { background: '#fff7e0', color: '#96720b', label: 'Pending Review' },
    approved:           { background: '#f0fdf4', color: '#16a34a', label: 'Approved' },
    rejected:           { background: '#fdecec', color: '#cc0000', label: 'Rejected' },
};

const fmtDate = (d) => (d ? new Date(d).toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' }) : '—');

/* Protected link builders — always route through the backend, never a raw storage URL. */
const approvedViewHref     = (doc) => (doc.has_file ? route('volunteer.file201.approved.view', doc.id) : null);
const approvedDownloadHref = (doc) => (doc.has_file ? route('volunteer.file201.approved.download', doc.id) : null);

export default function VolunteerFile201({ approvedFiles, documentRequests, folders }) {
    const docs = approvedFiles || [];
    const adminRequests = documentRequests || [];
    const folderList = folders || [];

    const [showNewFolder, setShowNewFolder] = useState(false);
    const [openFolderId, setOpenFolderId] = useState(null);
    const [approvedFilesModal, setApprovedFilesModal] = useState(null); // the approved group row being viewed
    const [statusTab, setStatusTab] = useState('approved'); // 'approved' | 'rejected'
    const [statusFilesModal, setStatusFilesModal] = useState(null); // { title, files } for rejected group view

    /* ---- Upload to fulfill a Document Request (no category -- up to 10 files) ---- */
    const uploadForm = useForm({ files: [], document_request_id: null });
    const [activeRequest, setActiveRequest] = useState(null);

    const openUploadForRequest = (req) => {
        uploadForm.setData({ files: [], document_request_id: req.id });
        setActiveRequest(req);
    };

    const closeUpload = () => {
        setActiveRequest(null);
        uploadForm.reset();
    };

    const handleFilesChange = (e) => {
        const picked = Array.from(e.target.files).slice(0, 10);
        uploadForm.setData('files', picked);
    };

    const removeSelectedFile = (index) => {
        uploadForm.setData('files', uploadForm.data.files.filter((_, i) => i !== index));
    };

    const handleUpload = (e) => {
        e.preventDefault();
        uploadForm.post(route('volunteer.file201.uploads.store'), {
            forceFormData: true,
            preserveScroll: true,
            onSuccess: closeUpload,
        });
    };

    /* ---- Approved files / folders ---- */
    const unfiled = docs.filter(d => d.is_group
        ? (d.files || []).some(f => !f.folder_id)
        : !d.folder_id
    );
    const openFolder = folderList.find(f => f.id === openFolderId) || null;

    /* Flatten group files too, so a file moved into a folder shows up there
       even if it was originally approved as part of a batch/group. */
    const allIndividualFiles = docs.flatMap(d =>
        d.is_group ? d.files.map(f => ({ ...f, name: f.original_name, date: d.date })) : [d]
    );
    const folderFiles = openFolder ? allIndividualFiles.filter(d => d.folder_id === openFolder.id) : [];

    /* Subfolders directly inside the currently open folder (or top-level, if none is open). */
    const childFolders = folderList.filter(f => (f.parent_id || null) === (openFolder ? openFolder.id : null));

    /* Breadcrumb chain from root down to the open folder, e.g. My Folders / Certs / 2026. */
    const breadcrumb = (() => {
        const chain = [];
        let current = openFolder;
        while (current) {
            chain.unshift(current);
            current = current.parent_id ? folderList.find(f => f.id === current.parent_id) : null;
        }
        return chain;
    })();

    /* Flat, indented folder list for "Move to folder" dropdowns, so a file can be moved
       straight into any nested folder without having to browse into it first. */
    /* All folder ids nested (at any depth) under a given folder, so counts
       can include files that live inside subfolders too. */
    const getDescendantFolderIds = (folderId) => {
        const direct = folderList.filter(f => f.parent_id === folderId).map(f => f.id);
        return direct.reduce((acc, id) => [...acc, id, ...getDescendantFolderIds(id)], []);
    };

    const folderDepth = (folder) => {
        let depth = 0;
        let current = folder;
        while (current && current.parent_id) {
            depth += 1;
            current = folderList.find(f => f.id === current.parent_id);
        }
        return depth;
    };
    const folderOptions = folderList.map(f => ({
        id: f.id,
        name: (folderDepth(f) > 0 ? '\u00A0\u00A0'.repeat(folderDepth(f)) + '\u21B3 ' : '') + f.name,
    }));

    const navigateToFolder = (id) => {
        setOpenFolderId(id);
        setShowNewFolder(false);
    };

    /* ---- Per-file status across all document requests (for the Rejected section) ---- */
    const rejectedUploads = [];
    adminRequests.forEach(req => {
        (req.uploads || []).forEach(u => {
            if (u.status === 'rejected') rejectedUploads.push({ ...u, request: req });
        });
    });

    /* Group by the request they came from, so a multi-file request shows as one row. */
    const groupByRequest = (uploads) => {
        const map = new Map();
        uploads.forEach(u => {
            const key = u.request.id;
            if (!map.has(key)) map.set(key, { request: u.request, files: [] });
            map.get(key).files.push(u);
        });
        return Array.from(map.values());
    };
    const rejectedGroups = groupByRequest(rejectedUploads);

    /* ---- Folders ---- */
    const folderForm = useForm({ name: '' });

    const handleCreateFolder = (e) => {
        e.preventDefault();
        if (!folderForm.data.name.trim()) return;
        folderForm.transform(data => ({ ...data, parent_id: openFolderId }));
        folderForm.post(route('volunteer.file201.folders.store'), {
            preserveScroll: true,
            onSuccess: () => { folderForm.reset(); folderForm.transform(data => data); setShowNewFolder(false); },
        });
    };

    const handleDeleteFolder = (folder) => {
        if (confirm(`Delete folder "${folder.name}"? Kasama ang mga subfolder sa loob nito. Ang mga file ay babalik sa "Approved" (hindi made-delete).`)) {
            router.delete(route('volunteer.file201.folders.destroy', folder.id), {
                preserveScroll: true,
                onSuccess: () => navigateToFolder(folder.parent_id || null),
            });
        }
    };

    const moveDoc = (doc, folderId) => {
        router.patch(route('volunteer.file201.documents.move', doc.id), {
            folder_id: folderId === '' ? null : Number(folderId),
        }, { preserveScroll: true });
    };

    /* Move every file inside an approved-request GROUP to a folder in one go. */
    const moveGroupDocs = (files, folderId) => {
        (files || []).forEach((f) => {
            if (!f.has_file && !f.id) return;
            router.patch(route('volunteer.file201.documents.move', f.id), {
                folder_id: folderId === '' ? null : Number(folderId),
            }, { preserveScroll: true });
        });
    };

    // Keep the approved-files modal's data in sync if the underlying prop refreshes
    const liveApprovedFilesModal = approvedFilesModal
        ? docs.find(d => d.is_group && d.id === approvedFilesModal.id) || null
        : null;

    const downloadAllApprovedFiles = (files) => {
        files.forEach((f, i) => {
            setTimeout(() => {
                if (!f.has_file) return;
                const link = document.createElement('a');
                link.href = route('volunteer.file201.approved.download', f.id);
                link.download = '';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }, i * 500);
        });
    };

    const cardStyle = { background: 'white', borderRadius: '10px', border: '1px solid #ebebeb', overflow: 'hidden' };
    const labelStyle = { fontSize: '11px', fontWeight: '600', color: '#888', display: 'block', marginBottom: '6px' };
    const fieldStyle = { width: '100%', padding: '9px 12px', border: '1px solid #ddd', borderRadius: '8px', fontSize: '12px', background: 'white', color: '#111', fontFamily: 'inherit' };
    const sectionTitle = { fontSize: '12px', fontWeight: '600', color: '#111' };
    const subheading = { fontSize: '13px', fontWeight: '700', color: '#111' };

    return (
        <VolunteerShell active="file201" title="201 File">

            <style>{`
                .f201-row:hover { background: #fafafa; }
                .f201-name-link:hover { text-decoration: underline !important; }
                .f201-icon-btn:hover { background: #f2f2f2 !important; }
                .f201-folder:hover { border-color: #d5d5d5 !important; }
            `}</style>

            {/* Header */}
            <div style={{ marginBottom: '20px' }}>
                <div style={{ fontSize: '14px', fontWeight: '700', color: '#111' }}>201 File</div>
                <div style={{ fontSize: '11px', color: '#aaa', marginTop: '2px' }}>Your approved files, folders, and document requests — all in one place.</div>
            </div>


            {/* ============================================================ */}
            {/* DOCUMENT REQUESTS (from admin)                                 */}
            {/* ============================================================ */}
            <div style={{ ...subheading, margin: '28px 0 10px' }}>Document Requests</div>
            <DataTable
                cardStyle={cardStyle}
                empty="No document requests from the admin yet."
                columns={['Document Requested', 'Instructions', 'Due Date', 'Requested By', 'Status', 'Action']}
                rows={adminRequests.map(req => {
                    const uploads = req.uploads || [];
                    const uploadCount = uploads.length;
                    const approvedCount = uploads.filter(u => u.status === 'approved').length;
                    const rejectedCount = uploads.filter(u => u.status === 'rejected').length;
                    const submittedCount = uploads.filter(u => u.status === 'submitted').length;
                    const isFullyApproved = uploadCount > 0 && approvedCount === uploadCount;
                    return [
                        <strong style={{ color: '#111', fontWeight: 600 }}>{req.document_name}</strong>,
                        req.instructions || '-',
                        req.due_date ? fmtDate(req.due_date) : '-',
                        req.requested_by || 'Administrator',
                        uploadCount === 0 ? (
                            <span style={{ color: '#ccc' }}>-</span>
                        ) : isFullyApproved ? (
                            <div
                                onClick={() => {
                                    const grp = docs.find(d => d.is_group && d.document_request_id === req.id);
                                    setStatusTab('approved');
                                    if (grp) setApprovedFilesModal(grp);
                                }}
                                style={{ color: '#16a34a', cursor: 'pointer', textDecoration: 'underline', fontWeight: '700', fontSize: '11px' }}
                            >&#10003; Fully Approved</div>
                        ) : (
                            <div style={{ fontSize: '10.5px', lineHeight: '1.8' }}>
                                {approvedCount > 0 && (
                                    <div
                                        onClick={() => {
                                            const grp = docs.find(d => d.is_group && d.document_request_id === req.id);
                                            setStatusTab('approved');
                                            if (grp) setApprovedFilesModal(grp);
                                        }}
                                        style={{ color: '#16a34a', cursor: 'pointer', textDecoration: 'underline', fontWeight: '600' }}
                                    >{approvedCount} Approved</div>
                                )}
                                {rejectedCount > 0 && (
                                    <div
                                        onClick={() => {
                                            const grp = rejectedGroups.find(g => g.request.id === req.id);
                                            setStatusTab('rejected');
                                            if (grp) setStatusFilesModal({ title: grp.request.document_name, files: grp.files, request: grp.request });
                                        }}
                                        style={{ color: '#CC0000', cursor: 'pointer', textDecoration: 'underline', fontWeight: '600' }}
                                    >{rejectedCount} Rejected</div>
                                )}
                                {submittedCount > 0 && <div style={{ color: '#96720b' }}>{submittedCount} Pending Review</div>}
                            </div>
                        ),
                        req.status === 'pending_submission' ? (
                            <button
                                onClick={() => openUploadForRequest(req)}
                                style={{ background: '#CC0000', color: '#fff', border: 'none', padding: '5px 12px', borderRadius: '6px', fontSize: '11px', fontWeight: 600, cursor: 'pointer', fontFamily: 'inherit' }}
                            >
                                Upload
                            </button>
                        ) : <span style={{ color: '#ccc' }}>-</span>,
                    ];
                })}
                keys={adminRequests.map(req => req.id)}
            />

            {/* ============================================================ */}
            {/* 1. APPROVED / REJECTED (tabbed)                               */}
            {/* ============================================================ */}
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: '12px', flexWrap: 'wrap', marginBottom: '12px' }}>
                <span style={subheading}>Approved Files &amp; Folders</span>
            </div>

            <div style={{ display: 'flex', gap: '8px', flexWrap: 'wrap', marginBottom: '16px' }}>
                <StatusTabButton active={statusTab === 'approved'} onClick={() => setStatusTab('approved')} label="Approved" count={unfiled.length} activeColor="#16a34a" />
                <StatusTabButton active={statusTab === 'rejected'} onClick={() => setStatusTab('rejected')} label="Rejected" count={rejectedUploads.length} activeColor="#cc0000" />
            </div>

            {statusTab === 'approved' && (
                <>
                    <DataTable
                        cardStyle={cardStyle}
                        empty="Walang bagong approved file. Kapag na-approve ang dokumento mo, lalabas dito para mailipat mo sa folder."
                        columns={['Document Name', 'Files']}
                        rowOnClick={unfiled.map(d => d.is_group
                            ? () => setApprovedFilesModal(d)
                            : () => { const href = approvedViewHref(d); if (href) window.open(href, '_blank', 'noopener'); }
                        )}
                        rows={unfiled.map(d => d.is_group ? [
                            <div>
                                <strong style={{ color: '#111', fontWeight: 600 }}>{d.name}</strong>
                                <div style={{ fontSize: '10.5px', color: '#999', marginTop: '4px' }}>{fmtDate(d.date)}</div>
                            </div>,
                            <button onClick={(e) => { e.stopPropagation(); setApprovedFilesModal(d); }} style={{
                                fontSize: '10.5px', padding: '5px 10px', borderRadius: '6px', border: 'none',
                                background: '#CC0000', color: 'white', fontWeight: '600', cursor: 'pointer', fontFamily: 'inherit', whiteSpace: 'nowrap',
                            }}>
                                View {d.files.length} File{d.files.length !== 1 ? 's' : ''}
                            </button>,
                        ] : [
                            <div>
                                <FileNameLink doc={d} />
                                <div style={{ fontSize: '10.5px', color: '#999', marginTop: '4px' }}>{fmtDate(d.date)}</div>
                            </div>,
                            <DownloadButton href={approvedDownloadHref(d)} />,
                        ])}
                        keys={unfiled.map(d => d.id)}
                    />
                    {unfiled.length > 0 && folderList.length === 0 && (
                        <div style={{ fontSize: '10.5px', color: '#b45309', marginTop: '8px' }}>
                            Wala ka pang folder. Gumawa muna sa "My Folders" sa baba para may mapaglipatan.
                        </div>
                    )}
                </>
            )}

            {statusTab === 'rejected' && (
                <DataTable
                    cardStyle={cardStyle}
                    empty="Walang rejected na file sa ngayon."
                    columns={['Document Requested', 'Files', 'Remarks']}
                    rowOnClick={rejectedGroups.map(g => () => setStatusFilesModal({ title: g.request.document_name, files: g.files, request: g.request }))}
                    rows={rejectedGroups.map(g => {
                        const latest = g.files.reduce((max, f) => (f.created_at > max.created_at ? f : max), g.files[0]);
                        return [
                        <div>
                            <strong style={{ color: '#111', fontWeight: 600 }}>{g.request.document_name}</strong>
                            <div style={{ fontSize: '10.5px', color: '#999', marginTop: '4px' }}>{fmtDate(latest.created_at)}</div>
                        </div>,
                        <button
                            onClick={(e) => { e.stopPropagation(); setStatusFilesModal({ title: g.request.document_name, files: g.files, request: g.request }); }}
                            style={{
                                fontSize: '10.5px', padding: '5px 10px', borderRadius: '6px', border: 'none',
                                background: '#CC0000', color: 'white', fontWeight: '600', cursor: 'pointer', fontFamily: 'inherit', whiteSpace: 'nowrap',
                            }}
                        >
                            View {g.files.length} File{g.files.length !== 1 ? 's' : ''}
                        </button>,
                        latest.admin_remarks ? (
                            <span style={{ fontSize: '11px', color: '#CC0000' }}>&quot;{latest.admin_remarks}&quot;</span>
                        ) : <span style={{ color: '#ccc' }}>-</span>,
                    ];})}
                    keys={rejectedGroups.map(g => g.request.id)}
                />
            )}


            <>
                    {/* My Folders */}
                    <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: '10px', flexWrap: 'wrap', margin: '24px 0 10px' }}>
                        <div style={{ display: 'flex', alignItems: 'center', flexWrap: 'wrap', gap: '4px' }}>
                            <span
                                onClick={() => navigateToFolder(null)}
                                style={{ ...sectionTitle, cursor: openFolder ? 'pointer' : 'default', color: openFolder ? '#888' : '#111' }}
                            >My Folders</span>
                            {breadcrumb.map((f, i) => (
                                <span key={f.id} style={{ display: 'flex', alignItems: 'center', gap: '4px' }}>
                                    <span style={{ color: '#ccc', fontSize: '11px' }}>/</span>
                                    <span
                                        onClick={() => i < breadcrumb.length - 1 && navigateToFolder(f.id)}
                                        style={{
                                            ...sectionTitle,
                                            cursor: i < breadcrumb.length - 1 ? 'pointer' : 'default',
                                            color: i < breadcrumb.length - 1 ? '#888' : '#111',
                                        }}
                                    >{f.name}</span>
                                </span>
                            ))}
                        </div>
                        <div style={{ display: 'flex', gap: '8px' }}>
                            {openFolder && (
                                <button type="button" onClick={() => handleDeleteFolder(openFolder)} style={{
                                    background: 'white', color: '#CC0000', border: '1px solid #f5c6c6', borderRadius: '8px',
                                    padding: '6px 12px', fontSize: '10.5px', fontWeight: '600', cursor: 'pointer', fontFamily: 'inherit',
                                }}>Delete this folder</button>
                            )}
                            <button type="button" onClick={() => setShowNewFolder(s => !s)} style={{
                                background: 'white', color: '#CC0000', border: '1px solid #f5c6c6', borderRadius: '8px',
                                padding: '6px 12px', fontSize: '10.5px', fontWeight: '600', cursor: 'pointer', fontFamily: 'inherit',
                            }}>+ New {openFolder ? 'Subfolder' : 'Folder'}</button>
                        </div>
                    </div>

                    {showNewFolder && (
                        <form onSubmit={handleCreateFolder} style={{ ...cardStyle, padding: '14px 16px', marginBottom: '12px', display: 'flex', gap: '8px', flexWrap: 'wrap', alignItems: 'flex-start' }}>
                            <div style={{ flex: '1 1 200px' }}>
                                <input
                                    type="text"
                                    className="vp-input"
                                    autoFocus
                                    maxLength={60}
                                    value={folderForm.data.name}
                                    onChange={e => folderForm.setData('name', e.target.value)}
                                    placeholder="Folder name (e.g. Certificates)"
                                    aria-label="Folder name"
                                    style={fieldStyle}
                                />
                                {folderForm.errors.name && <div style={{ fontSize: '10.5px', color: '#CC0000', marginTop: '4px' }}>{folderForm.errors.name}</div>}
                            </div>
                            <button
                                type="submit"
                                disabled={folderForm.processing || !folderForm.data.name.trim()}
                                className="btn-view"
                                style={{
                                    background: '#CC0000', color: 'white', border: 'none', borderRadius: '8px',
                                    padding: '9px 18px', fontSize: '11.5px', fontWeight: '600', fontFamily: 'inherit',
                                    cursor: (folderForm.processing || !folderForm.data.name.trim()) ? 'not-allowed' : 'pointer',
                                    opacity: (folderForm.processing || !folderForm.data.name.trim()) ? 0.5 : 1,
                                }}
                            >
                                Create
                            </button>
                            <button type="button" onClick={() => { setShowNewFolder(false); folderForm.reset(); }} style={{
                                background: 'white', color: '#666', border: '1px solid #ebebeb', borderRadius: '8px',
                                padding: '9px 16px', fontSize: '11.5px', fontWeight: '500', cursor: 'pointer', fontFamily: 'inherit',
                            }}>Cancel</button>
                        </form>
                    )}

                    {childFolders.length === 0 && folderFiles.length === 0 ? (
                        <div style={{ ...cardStyle, padding: '36px 20px', textAlign: 'center' }}>
                            <div style={{ fontSize: '11.5px', color: '#aaa' }}>
                                {openFolder
                                    ? 'Walang laman ang folder na ito. Gumawa ng subfolder o ilipat dito ang mga approved file mula sa itaas.'
                                    : 'Wala ka pang folder. Gumawa ng sarili mong folder para ma-organize ang mga approved files mo.'}
                            </div>
                        </div>
                    ) : (
                        <>
                            {childFolders.length > 0 && (
                                <div style={{
                                    display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(180px, 1fr))', gap: '12px',
                                    marginBottom: folderFiles.length > 0 ? '16px' : 0,
                                }}>
                                    {childFolders.map(f => {
                                        const nestedIds = [f.id, ...getDescendantFolderIds(f.id)];
                                        const n = allIndividualFiles.filter(d => nestedIds.includes(d.folder_id)).length;
                                        const subCount = folderList.filter(sf => sf.parent_id === f.id).length;
                                        return (
                                            <button
                                                key={f.id}
                                                type="button"
                                                className="f201-folder"
                                                onClick={() => navigateToFolder(f.id)}
                                                style={{
                                                    ...cardStyle, textAlign: 'left', fontFamily: 'inherit', cursor: 'pointer',
                                                    padding: '16px', width: '100%',
                                                }}
                                            >
                                                <span style={{ width: '32px', height: '32px', borderRadius: '8px', background: '#fffbeb', display: 'flex', alignItems: 'center', justifyContent: 'center', marginBottom: '10px' }}>
                                                    <FolderIcon color="#F59E0B" size={16} />
                                                </span>
                                                <div style={{ fontSize: '12px', fontWeight: '600', color: '#111', marginBottom: '2px', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{f.name}</div>
                                                <div style={{ fontSize: '10.5px', color: (n > 0 || subCount > 0) ? '#999' : '#ccc' }}>
                                                    {subCount > 0 ? `${subCount} folder${subCount !== 1 ? 's' : ''}, ` : ''}{n} file{n !== 1 ? 's' : ''}
                                                </div>
                                            </button>
                                        );
                                    })}
                                </div>
                            )}
                            {openFolder && (
                                <DataTable
                                    cardStyle={cardStyle}
                                    empty="Walang file dito. Ilipat dito ang mga approved file mula sa itaas."
                                    columns={['Document Name', 'Download', 'Move']}
                                    rowOnClick={folderFiles.map(d => () => { const href = approvedViewHref(d); if (href) window.open(href, '_blank', 'noopener'); })}
                                    rows={folderFiles.map(d => [
                                        <div>
                                            <FileNameLink doc={d} />
                                            <div style={{ fontSize: '10.5px', color: '#999', marginTop: '4px' }}>{fmtDate(d.date)}</div>
                                        </div>,
                                        <DownloadButton href={approvedDownloadHref(d)} />,
                                        <MoveSelect
                                            folders={folderOptions.filter(o => o.id !== openFolder.id)}
                                            value=""
                                            onChange={(v) => moveDoc(d, v)}
                                            placeholder="Move to…"
                                            allowUnfile
                                            style={fieldStyle}
                                        />,
                                    ])}
                                    keys={folderFiles.map(d => d.id)}
                                />
                            )}
                        </>
                    )}
            </>

            {/* Rejected files modal -- shows each file's remarks within a request */}
            {statusFilesModal && (
                <div
                    role="dialog"
                    aria-modal="true"
                    style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.35)', display: 'flex', alignItems: 'center', justifyContent: 'center', zIndex: 50, padding: '16px' }}
                    onClick={() => setStatusFilesModal(null)}
                >
                    <div style={{ ...cardStyle, width: '100%', maxWidth: '460px', maxHeight: '80vh', overflowY: 'auto' }} onClick={e => e.stopPropagation()}>
                        <div style={{ padding: '14px 18px', borderBottom: '1px solid #f5f5f5', display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: '10px', flexWrap: 'wrap' }}>
                            <span style={sectionTitle}>{statusFilesModal.title}</span>
                            <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>
                                <button
                                    type="button"
                                    onClick={() => { const req = statusFilesModal.request; setStatusFilesModal(null); openUploadForRequest(req); }}
                                    style={{ background: '#CC0000', color: '#fff', border: 'none', padding: '5px 12px', borderRadius: '6px', fontSize: '11px', fontWeight: 600, cursor: 'pointer', fontFamily: 'inherit' }}
                                >Re-upload</button>
                                <button type="button" onClick={() => setStatusFilesModal(null)} aria-label="Close" style={{ background: 'none', border: 'none', cursor: 'pointer', color: '#aaa', fontSize: '14px', lineHeight: 1 }}>&times;</button>
                            </div>
                        </div>
                        <div>
                            {statusFilesModal.files.map((f, i) => (
                                <div key={f.id} style={{ padding: '12px 18px', borderBottom: i < statusFilesModal.files.length - 1 ? '1px solid #f5f5f5' : 'none' }}>
                                    <div style={{ fontSize: '12px', color: '#111', fontWeight: 600 }}>{f.original_name}</div>
                                    <div style={{ fontSize: '11px', color: '#999', marginTop: '4px' }}>{f.admin_remarks ? `"${f.admin_remarks}"` : 'No remarks'}</div>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            )}

            {/* Approved-group files modal -- shows every file approved under one request */}
            {liveApprovedFilesModal && (
                <div
                    role="dialog"
                    aria-modal="true"
                    style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.35)', display: 'flex', alignItems: 'center', justifyContent: 'center', zIndex: 50, padding: '16px' }}
                    onClick={() => setApprovedFilesModal(null)}
                >
                    <div style={{ ...cardStyle, width: '100%', maxWidth: '460px', maxHeight: '80vh', overflowY: 'auto' }} onClick={e => e.stopPropagation()}>
                        <div style={{ padding: '14px 18px', borderBottom: '1px solid #f5f5f5', display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: '10px', flexWrap: 'wrap' }}>
                            <span style={sectionTitle}>{liveApprovedFilesModal.name}</span>
                            <div style={{ display: 'flex', alignItems: 'center', gap: '10px', flexWrap: 'wrap' }}>
                                <MoveSelect
                                    folders={folderOptions}
                                    value=""
                                    onChange={(v) => moveGroupDocs(liveApprovedFilesModal.files, v)}
                                    placeholder="Move all to…"
                                    style={fieldStyle}
                                />
                                <button
                                    type="button"
                                    onClick={() => downloadAllApprovedFiles(liveApprovedFilesModal.files)}
                                    style={{
                                        fontSize: '10.5px', padding: '5px 10px', borderRadius: '6px', border: '1px solid #e0e0e0',
                                        color: '#333', fontWeight: '600', cursor: 'pointer', background: 'white', fontFamily: 'inherit',
                                    }}
                                >Download All</button>
                                <button type="button" onClick={() => setApprovedFilesModal(null)} aria-label="Close" style={{ background: 'none', border: 'none', cursor: 'pointer', color: '#aaa', fontSize: '14px', lineHeight: 1 }}>&times;</button>
                            </div>
                        </div>
                        <div>
                            {liveApprovedFilesModal.files.filter(f => !f.folder_id).length === 0 ? (
                                <div style={{ padding: '24px 18px', textAlign: 'center', fontSize: '11.5px', color: '#aaa' }}>
                                    Lahat ng file ay na-move na sa mga folder.
                                </div>
                            ) : liveApprovedFilesModal.files.filter(f => !f.folder_id).map((f, i, arr) => (
                                <div key={f.id} style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', padding: '12px 18px', borderBottom: i < arr.length - 1 ? '1px solid #f5f5f5' : 'none', gap: '10px' }}>
                                    <div style={{ flex: '1 1 auto', minWidth: 0, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                                        {f.has_file ? (
                                            <a
                                                href={route('volunteer.file201.approved.view', f.id)}
                                                target="_blank"
                                                rel="noreferrer"
                                                className="f201-name-link"
                                                style={{ fontSize: '12px', color: '#111', fontWeight: 600, textDecoration: 'none' }}
                                            >{f.original_name}</a>
                                        ) : (
                                            <span style={{ fontSize: '12px', color: '#111', fontWeight: 600 }}>{f.original_name}</span>
                                        )}
                                    </div>
                                    <div style={{ display: 'flex', alignItems: 'center', gap: '8px', flexShrink: 0 }}>
                                        <MoveSelect
                                            folders={folderOptions}
                                            value=""
                                            onChange={(v) => moveDoc(f, v)}
                                            placeholder="Move to…"
                                            style={fieldStyle}
                                        />
                                        <DownloadButton href={f.has_file ? route('volunteer.file201.approved.download', f.id) : null} />
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            )}

            {/* Upload modal for a Document Request -- up to 10 files, no category */}
            {activeRequest && (
                <div
                    role="dialog"
                    aria-modal="true"
                    style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.35)', display: 'flex', alignItems: 'center', justifyContent: 'center', zIndex: 50, padding: '16px' }}
                    onClick={closeUpload}
                >
                    <div style={{ ...cardStyle, width: '100%', maxWidth: '420px' }} onClick={e => e.stopPropagation()}>
                        <div style={{ padding: '14px 18px', borderBottom: '1px solid #f5f5f5', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                            <span style={sectionTitle}>Upload: {activeRequest.document_name}</span>
                            <button type="button" onClick={closeUpload} aria-label="Close upload form" style={{ background: 'none', border: 'none', cursor: 'pointer', color: '#aaa', fontSize: '14px', lineHeight: 1 }}>&times;</button>
                        </div>

                        {activeRequest.uploads && activeRequest.uploads.some(u => u.status === 'rejected') && (
                            <div style={{ margin: '14px 18px 0', padding: '10px 12px', background: '#fff7f0', border: '1px solid #fde3d0', borderRadius: '8px' }}>
                                <div style={{ fontSize: '10px', fontWeight: '700', color: '#b45309', textTransform: 'uppercase', letterSpacing: '0.3px', marginBottom: '8px' }}>
                                    Previous submission
                                </div>
                                {activeRequest.uploads
                                    .filter(u => u.status === 'rejected')
                                    .map(u => (
                                        <div key={u.id} style={{ fontSize: '11px', color: '#111', fontWeight: 600, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', marginBottom: '4px' }}>
                                            {u.original_name}
                                        </div>
                                    ))}
                            </div>
                        )}

                        <form onSubmit={handleUpload} style={{ padding: '18px' }}>
                            <label htmlFor="req-upload-file" style={labelStyle}>
                                Files <span style={{ color: '#ccc', fontWeight: '400' }}>(PDF, JPG, PNG -- max 5MB each, up to 10 files)</span>
                            </label>
                            <input
                                id="req-upload-file"
                                type="file"
                                multiple
                                accept=".pdf,.jpg,.jpeg,.png"
                                onChange={handleFilesChange}
                                style={{ width: '100%', padding: '7px 0', fontSize: '12px', marginBottom: '10px' }}
                            />
                            {uploadForm.data.files.length > 0 && (
                                <div style={{ marginBottom: '12px', border: '1px solid #eee', borderRadius: '8px', overflow: 'hidden' }}>
                                    {uploadForm.data.files.map((f, i) => (
                                        <div key={i} style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', padding: '6px 10px', fontSize: '11px', color: '#555', borderBottom: i < uploadForm.data.files.length - 1 ? '1px solid #f5f5f5' : 'none' }}>
                                            <span style={{ overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', maxWidth: '260px' }}>{f.name}</span>
                                            <button type="button" onClick={() => removeSelectedFile(i)} style={{ border: 'none', background: 'transparent', color: '#CC0000', fontWeight: '700', cursor: 'pointer', fontSize: '13px' }}>&times;</button>
                                        </div>
                                    ))}
                                </div>
                            )}
                            {uploadForm.errors.files && <div style={{ fontSize: '10.5px', color: '#CC0000', marginBottom: '10px' }}>{uploadForm.errors.files}</div>}
                            <div style={{ display: 'flex', gap: '8px' }}>
                                <button
                                    type="submit"
                                    disabled={uploadForm.processing || uploadForm.data.files.length === 0}
                                    className="btn-view"
                                    style={{
                                        background: '#CC0000', color: 'white', border: 'none', borderRadius: '8px',
                                        padding: '9px 20px', fontSize: '11.5px', fontWeight: '600', fontFamily: 'inherit',
                                        cursor: (uploadForm.processing || uploadForm.data.files.length === 0) ? 'not-allowed' : 'pointer',
                                        opacity: (uploadForm.processing || uploadForm.data.files.length === 0) ? 0.6 : 1,
                                    }}
                                >
                                    {uploadForm.processing ? 'Uploading...' : 'Upload'}
                                </button>
                                <button type="button" onClick={closeUpload} style={{
                                    background: 'white', color: '#666', border: '1px solid #ebebeb', borderRadius: '8px',
                                    padding: '9px 18px', fontSize: '11.5px', fontWeight: '500', cursor: 'pointer', fontFamily: 'inherit',
                                }}>Cancel</button>
                            </div>
                        </form>
                    </div>
                </div>
            )}

        </VolunteerShell>
    );
}

/* ---------------- Shared pieces ---------------- */

function StatusTabButton({ active, onClick, label, count, activeColor = '#CC0000' }) {
    return (
        <button
            type="button"
            onClick={onClick}
            style={{
                display: 'flex', alignItems: 'center', gap: '6px',
                padding: '7px 14px', borderRadius: '20px', fontFamily: 'inherit',
                fontSize: '11.5px', fontWeight: '600', cursor: 'pointer',
                border: active ? `1px solid ${activeColor}` : '1px solid #ebebeb',
                background: active ? activeColor : 'white',
                color: active ? 'white' : '#666',
            }}
        >
            {label}
            <span style={{
                fontSize: '10px', fontWeight: '700', borderRadius: '10px', padding: '1px 7px',
                background: active ? 'rgba(255,255,255,0.25)' : '#f5f5f5',
                color: active ? 'white' : '#999',
            }}>{count}</span>
        </button>
    );
}

function MoveSelect({ folders, value, onChange, placeholder, allowUnfile = false, style }) {
    return (
        <select
            className="vp-input"
            value={value}
            onClick={(e) => e.stopPropagation()}
            onChange={(e) => onChange(e.target.value)}
            aria-label="Move to folder"
            disabled={folders.length === 0 && !allowUnfile}
            style={{ ...style, padding: '5px 8px', fontSize: '11px', minWidth: '130px', width: 'auto' }}
        >
            <option value="" disabled={!allowUnfile}>{placeholder}</option>
            {allowUnfile && <option value="">↩ Back to Approved</option>}
            {folders.map(f => <option key={f.id} value={f.id}>{f.name}</option>)}
        </select>
    );
}

function DataTable({ cardStyle, columns, rows, keys, empty, rowOnClick }) {
    if (rows.length === 0) {
        return (
            <div style={{ ...cardStyle, padding: '40px 20px', textAlign: 'center' }}>
                <div style={{ width: '44px', height: '44px', borderRadius: '10px', background: '#f5f5f5', display: 'flex', alignItems: 'center', justifyContent: 'center', margin: '0 auto 12px' }}>
                    <FileIcon color="#ccc" size={20} />
                </div>
                <div style={{ fontSize: '11.5px', color: '#aaa' }}>{empty}</div>
            </div>
        );
    }

    return (
        <div style={cardStyle}>
            <div style={{ overflowX: 'auto' }}>
                <table style={{ width: '100%', borderCollapse: 'collapse', minWidth: '560px' }}>
                    <thead>
                        <tr style={{ background: '#fafafa', borderBottom: '1px solid #f0f0f0' }}>
                            {columns.map(c => (
                                <th key={c} style={{ textAlign: 'left', padding: '10px 16px', fontSize: '10px', fontWeight: '600', color: '#aaa', textTransform: 'uppercase', letterSpacing: '0.3px', whiteSpace: 'nowrap' }}>
                                    {c}
                                </th>
                            ))}
                        </tr>
                    </thead>
                    <tbody>
                        {rows.map((cells, i) => {
                            const onRowClick = rowOnClick && rowOnClick[i];
                            return (
                                <tr
                                    key={keys[i] ?? i}
                                    className="f201-row"
                                    onClick={onRowClick || undefined}
                                    style={{
                                        borderBottom: i < rows.length - 1 ? '1px solid #f5f5f5' : 'none',
                                        cursor: onRowClick ? 'pointer' : 'default',
                                    }}
                                >
                                    {cells.map((cell, j) => (
                                        <td key={j} style={{ padding: '12px 16px', fontSize: '12px', color: '#555', verticalAlign: 'top', lineHeight: '1.5' }}>
                                            {cell}
                                        </td>
                                    ))}
                                </tr>
                            );
                        })}
                    </tbody>
                </table>
            </div>
        </div>
    );
}

/* Document name -- clickable straight to the protected view route when a file exists. */
function FileNameLink({ doc }) {
    const href = approvedViewHref(doc);
    if (!href) return <strong style={{ color: '#111', fontWeight: 600 }}>{doc.name}</strong>;
    return (
        <a
            href={href}
            target="_blank"
            rel="noreferrer"
            className="f201-name-link"
            onClick={(e) => e.stopPropagation()}
            style={{ color: '#111', fontWeight: 600, textDecoration: 'none' }}
        >
            {doc.name}
        </a>
    );
}

/* Small icon-only download button. Shows a dash when the record has no file yet. */
function DownloadButton({ href }) {
    if (!href) return <span style={{ color: '#ccc' }}>—</span>;
    return (
        <a
            href={href}
            download
            title="Download"
            className="f201-icon-btn"
            onClick={(e) => e.stopPropagation()}
            style={{
                display: 'inline-flex', alignItems: 'center', justifyContent: 'center',
                width: '28px', height: '28px', borderRadius: '6px', border: '1px solid #e0e0e0',
                color: '#333', textDecoration: 'none',
            }}
        >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
        </a>
    );
}

function FileIcon({ color = '#aaa', size = 16 }) {
    return (
        <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke={color} strokeWidth="1.8" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
        </svg>
    );
}

function FolderIcon({ color = '#aaa', size = 16 }) {
    return (
        <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke={color} strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
        </svg>
    );
}
