import { router, useForm } from '@inertiajs/react';
import { useEffect, useRef, useState } from 'react';
import VolunteerShell from '../../Components/VolunteerShell';

/* ------------------------------------------------------------------ */
/* 201 File - everything in one page:                                 */
/*  1. Approved (files the Red Cross gives you) + your own Folders     */
/*  2. Document Requests (from admin) - upload directly, no category   */
/*                                                                       */
/*  Files are never linked to directly. View/Download always go        */
/*  through a protected backend route (view/download by id) that       */
/*  checks the document belongs to the logged-in volunteer first.      */
/* ------------------------------------------------------------------ */

const DOC_REQUEST_STATUS = {
    pending_submission: { background: '#fffbeb', color: '#b45309', label: 'Pending Submission' },
    submitted:          { background: '#fff7e0', color: '#96720b', label: 'Pending Review' },
    approved:           { background: '#f0fdf4', color: '#16a34a', label: 'Approved' },
    rejected:           { background: '#fdecec', color: '#cc0000', label: 'Rejected' },
};

function groupByMonth(items, getDate) {
    const map = new Map();
    items.forEach(item => {
        const d = new Date(getDate(item));
        const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
        const label = d.toLocaleDateString('en-PH', { month: 'long', year: 'numeric' });
        if (!map.has(key)) map.set(key, { key, label, items: [] });
        map.get(key).items.push(item);
    });
    return Array.from(map.values()).sort((a, b) => b.key.localeCompare(a.key));
}

function toggleMonth(key, setter) {
    setter(prev => {
        const next = new Set(prev);
        if (next.has(key)) next.delete(key); else next.add(key);
        return next;
    });
}

function MonthHeader({ label, count, collapsed, onClick }) {
    return (
        <button
            type="button"
            onClick={onClick}
            style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', width: '100%', background: 'none', border: 'none', padding: '8px 2px', cursor: 'pointer', fontFamily: 'inherit' }}
        >
            <span style={{ fontSize: '11px', fontWeight: 700, color: '#666', textTransform: 'uppercase', letterSpacing: '0.4px' }}>
                {label} <span style={{ color: '#ccc', fontWeight: 500 }}>({count})</span>
            </span>
            <ChevronIcon open={!collapsed} />
        </button>
    );
}

const fmtDate = (d) => (d ? new Date(d).toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' }) : '-');

/* Protected link builders - always route through the backend, never a raw storage URL. */
const approvedViewHref     = (doc) => (doc.has_file ? route('volunteer.file201.approved.view', doc.id) : null);
const pendingViewHref      = (doc) => route('volunteer.file201.uploads.view', doc.id);
const approvedDownloadHref = (doc) => (doc.has_file ? route('volunteer.file201.approved.download', doc.id) : null);

export default function VolunteerFile201({ approvedFiles, documentRequests, folders, archivedFiles }) {
    const docs = approvedFiles || [];
    const adminRequests = documentRequests || [];
    const activeRequests = adminRequests.filter(r => {
        const uploads = r.uploads || [];
        return uploads.length === 0;
    });
    const folderList = folders || [];
    const archivedList = archivedFiles || [];

    const [showNewFolder, setShowNewFolder] = useState(false);
    const [openFolderId, setOpenFolderId] = useState(null);
    const [statusTab, setStatusTab] = useState('approved'); // 'pending' | 'approved' | 'rejected' | 'archive'
    const [archivePrompt, setArchivePrompt] = useState(null);
    const [archiveOpen, setArchiveOpen] = useState(false);
    const [archiveMenu, setArchiveMenu] = useState(null);
    const [archiveMoveOpen, setArchiveMoveOpen] = useState(false);

    const jumpToStatus = (tab) => {
        setStatusTab(tab);
        setTimeout(() => {
            const el = document.getElementById('approved-section');
            if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 50);
    };

    /* ---- Which card is expanded, per section (only one open at a time per section) ---- */
    const [expandedRequestId, setExpandedRequestId] = useState(null);
    const [expandedApprovedKey, setExpandedApprovedKey] = useState(null);
    const [expandedRejectedKey, setExpandedRejectedKey] = useState(null);
    const [expandedPendingKey, setExpandedPendingKey] = useState(null);
    const [collapsedApprovedMonths, setCollapsedApprovedMonths] = useState(new Set());
    const [collapsedRejectedMonths, setCollapsedRejectedMonths] = useState(new Set());
    const [collapsedPendingMonths, setCollapsedPendingMonths] = useState(new Set());

    /* ---- Upload to fulfill a Document Request (no category -- up to 10 files) ---- */
    const uploadForm = useForm({ files: [], document_request_id: null });
    const [activeRequest, setActiveRequest] = useState(null);
    const [uploadSuccessMsg, setUploadSuccessMsg] = useState('');

    const openUploadForRequest = (req) => {
        uploadForm.setData({ files: [], document_request_id: req.id });
        setActiveRequest(req);
    };

    const closeUpload = () => {
        setActiveRequest(null);
        uploadForm.reset();
    };

    const handleFilesChange = (e) => {
        const picked = Array.from(e.target.files);
        uploadForm.setData('files', picked);
    };

    const removeSelectedFile = (index) => {
        const remaining = uploadForm.data.files.filter((_, i) => i !== index);
        uploadForm.setData('files', remaining);
        const input = document.getElementById('req-upload-file');
        if (input) {
            try {
                const dt = new DataTransfer();
                remaining.forEach(f => dt.items.add(f));
                input.files = dt.files;
            } catch (err) {}
        }
    };

    const rejectedUploadsCount = activeRequest?.uploads?.filter(u => u.status === 'rejected').length || 0;
    const keptUploadsCount = activeRequest?.uploads?.filter(u => u.status === 'pending' || u.status === 'approved').length || 0;
    const requiredCount = activeRequest?.max_files > 0 ? Math.max(activeRequest.max_files - keptUploadsCount, 0) : 0;
    const maxFiles = requiredCount > 0 ? requiredCount : (rejectedUploadsCount > 0 ? rejectedUploadsCount : (activeRequest?.max_files || 10));
    const overLimit = uploadForm.data.files.length > maxFiles;
    const underLimit = requiredCount > 0 && uploadForm.data.files.length < requiredCount;

    const handleUpload = (e) => {
        e.preventDefault();
        if (overLimit || underLimit) return;
        uploadForm.post(route('volunteer.file201.uploads.store'), {
            forceFormData: true,
            preserveScroll: true,
            preserveState: true,
            onSuccess: () => {
                const submittedName = uploadForm.data.files.map(f => f.name).join(', ') || activeRequest?.document_name || 'document';
                closeUpload();
                setUploadSuccessMsg(`${submittedName} has been submitted for review. Its status is now Pending.`);
                setTimeout(() => setUploadSuccessMsg(''), 10000);
            },
        });
    };

    /* ---- Approved files / folders ---- */
    const unfiled = docs.filter(d => d.is_group
        ? (d.files || []).some(f => !f.folder_id)
        : !d.folder_id
    );
    const openFolder = folderList.find(f => f.id === openFolderId) || null;

    /* Flatten group files too, so a file moved into a folder shows up there
       even if it was originally approved as part of a batch/group. */
    const allIndividualFiles = docs.flatMap(d =>
        d.is_group ? d.files.map(f => ({ ...f, name: f.original_name, date: d.date })) : [d]
    );
    const folderFiles = openFolder ? allIndividualFiles.filter(d => d.folder_id === openFolder.id) : [];

    /* Subfolders directly inside the currently open folder (or top-level, if none is open). */
    const childFolders = folderList.filter(f => (f.parent_id || null) === (openFolder ? openFolder.id : null));

    /* Breadcrumb chain from root down to the open folder, e.g. My Folders / Certs / 2026. */
    const breadcrumb = (() => {
        const chain = [];
        let current = openFolder;
        while (current) {
            chain.unshift(current);
            current = current.parent_id ? folderList.find(f => f.id === current.parent_id) : null;
        }
        return chain;
    })();

    /* Flat, indented folder list for "Move to folder" dropdowns, so a file can be moved
       straight into any nested folder without having to browse into it first. */
    /* All folder ids nested (at any depth) under a given folder, so counts
       can include files that live inside subfolders too. */
    const getDescendantFolderIds = (folderId) => {
        const direct = folderList.filter(f => f.parent_id === folderId).map(f => f.id);
        return direct.reduce((acc, id) => [...acc, id, ...getDescendantFolderIds(id)], []);
    };

    const folderDepth = (folder) => {
        let depth = 0;
        let current = folder;
        while (current && current.parent_id) {
            depth += 1;
            current = folderList.find(f => f.id === current.parent_id);
        }
        return depth;
    };
    const folderOptions = (() => {
        const out = [];
        const seen = new Set();
        const walk = (parentId, trail) => {
            folderList
                .filter(f => (f.parent_id || null) === parentId)
                .sort((a, b) => a.name.localeCompare(b.name))
                .forEach(f => {
                    if (seen.has(f.id)) return;
                    seen.add(f.id);
                    const p = [...trail, f.name];
                    out.push({ id: f.id, name: trail.length ? '\u00A0\u00A0'.repeat(trail.length) + '\u21B3 ' + f.name : f.name });
                    walk(f.id, p);
                });
        };
        walk(null, []);
        folderList.forEach(f => { if (!seen.has(f.id)) out.push({ id: f.id, name: f.name }); });
        return out;
    })();

    const navigateToFolder = (id) => {
        setArchiveOpen(false);
        setOpenFolderId(id);
        clearSelection();
        setShowNewFolder(false);
    };

    /* ---- Per-file status across all document requests (for the Rejected section) ---- */
    const rejectedUploads = [];
    adminRequests.forEach(req => {
        (req.uploads || []).forEach(u => {
            if (u.status === 'rejected') rejectedUploads.push({ ...u, request: req });
        });
    });

    const pendingUploads = [];
    adminRequests.forEach(req => {
        (req.uploads || []).forEach(u => {
            if (u.status === 'pending' || u.status === 'needs_revision') pendingUploads.push({ ...u, request: req });
        });
    });

    /* Group by the request they came from, so a multi-file request shows as one row. */
    const groupByRequest = (uploads) => {
        const map = new Map();
        uploads.forEach(u => {
            const key = u.request.id;
            if (!map.has(key)) map.set(key, { request: u.request, files: [] });
            map.get(key).files.push(u);
        });
        return Array.from(map.values());
    };
    const rejectedGroups = groupByRequest(rejectedUploads);
    const rejectedGroupsWithDate = rejectedGroups.map(g => ({
        ...g,
        latestDate: g.files.reduce((max, f) => (f.created_at > max ? f.created_at : max), g.files[0].created_at),
    }));
    const approvedMonths = groupByMonth(unfiled, d => d.date);
    const rejectedMonths = groupByMonth(rejectedGroupsWithDate, g => g.latestDate);

    const pendingGroups = groupByRequest(pendingUploads);
    const pendingGroupsWithDate = pendingGroups.map(g => ({
        ...g,
        latestDate: g.files.reduce((max, f) => (f.created_at > max ? f.created_at : max), g.files[0].created_at),
    }));
    const pendingMonths = groupByMonth(pendingGroupsWithDate, g => g.latestDate);

    /* ---- Folders ---- */
    const folderForm = useForm({ name: '' });

    const handleCreateFolder = (e) => {
        e.preventDefault();
        if (!folderForm.data.name.trim()) return;
        folderForm.transform(data => ({ ...data, parent_id: openFolderId }));
        folderForm.post(route('volunteer.file201.folders.store'), {
            preserveScroll: true,
            onSuccess: () => { folderForm.reset(); folderForm.transform(data => data); setShowNewFolder(false); },
        });
    };

    const handleDeleteFolder = (folder) => {
        const treeIds = [folder.id, ...getDescendantFolderIds(folder.id)];
        const hasFiles = allIndividualFiles.some(d => treeIds.includes(d.folder_id));

        if (hasFiles) {
            setArchivePrompt(folder);
            return;
        }

        if (confirm(`Delete folder "${folder.name}"? This includes all subfolders inside it.`)) {
            router.delete(route('volunteer.file201.folders.destroy', folder.id), {
                preserveScroll: true,
                onSuccess: () => navigateToFolder(folder.parent_id || null),
            });
        }
    };

    const confirmArchiveFolder = () => {
        const target = archivePrompt;
        if (!target) return;
        const payload = target.document_ids ? { document_ids: target.document_ids } : { folder_id: target.id };
        router.post(route('volunteer.file201.archive'), payload, {
            preserveScroll: true,
            onFinish: () => { setArchivePrompt(null); clearSelection(); },
        });
    };

    const moveDoc = (doc, folderId) => {
        router.patch(route('volunteer.file201.documents.move', doc.id), {
            folder_id: folderId === '' ? null : Number(folderId),
        }, { preserveScroll: true });
    };

    /* ---- Rename an approved file ---- */
    const [renameTarget, setRenameTarget] = useState(null);
    const [renameValue, setRenameValue] = useState('');
    const [renameSaving, setRenameSaving] = useState(false);

    const openRename = (doc) => {
        setRenameTarget(doc);
        setRenameValue(doc.original_name || doc.name || '');
    };

    const closeRename = () => {
        setRenameTarget(null);
        setRenameValue('');
        setRenameSaving(false);
    };

    const saveRename = () => {
        if (!renameValue.trim() || !renameTarget) return;
        setRenameSaving(true);
        router.patch(route('volunteer.file201.documents.rename', renameTarget.id), {
            original_name: renameValue.trim(),
        }, {
            preserveScroll: true,
            onFinish: () => closeRename(),
        });
    };

    /* ---- Rename a folder ---- */
    const [renameFolderTarget, setRenameFolderTarget] = useState(null);
    const [renameFolderValue, setRenameFolderValue] = useState('');
    const [renameFolderSaving, setRenameFolderSaving] = useState(false);

    const openRenameFolder = (folder) => {
        setRenameFolderTarget(folder);
        setRenameFolderValue(folder.name || '');
    };

    const closeRenameFolder = () => {
        setRenameFolderTarget(null);
        setRenameFolderValue('');
        setRenameFolderSaving(false);
    };

    const saveRenameFolder = () => {
        if (!renameFolderValue.trim() || !renameFolderTarget) return;
        setRenameFolderSaving(true);
        router.patch(route('volunteer.file201.folders.rename', renameFolderTarget.id), {
            name: renameFolderValue.trim(),
        }, {
            preserveScroll: true,
            onFinish: () => closeRenameFolder(),
        });
    };

    /* ---- Move a folder to a different parent ---- */
    const moveFolder = (folder, parentId) => {
        router.patch(route('volunteer.file201.folders.move', folder.id), {
            parent_id: parentId === '' ? null : Number(parentId),
        }, { preserveScroll: true });
    };

    /* ---- Mobile long-press action menu (folders + files) ---- */
    const longPressTimer = useRef(null);
    const suppressNextClick = useRef(false);
    const [actionMenu, setActionMenu] = useState(null);
    const [blankMenu, setBlankMenu] = useState(null);
    useEffect(() => {
        const marker = () => document.querySelector('[data-folder-actions]');
        const isBlank = (t) => {
            const m = marker();
            if (!m || !t || !t.closest) return false;
            const header = m.parentElement;
            const area = header && header.parentElement;
            if (!area || !area.contains(t) || header.contains(t)) return false;
            if (t.closest('[data-blank-menu]')) return false;
            if (t.closest('button, a, input, select, textarea, form, label')) return false;
            return true;
        };
        let timer = null;
        const clear = () => { clearTimeout(timer); };
        const onContext = (e) => {
            if (e.defaultPrevented || !openFolder || !isBlank(e.target)) return;
            e.preventDefault();
            setBlankMenu({ x: e.clientX, y: e.clientY });
        };
        const onDown = (e) => {
            if (!e.target.closest || !e.target.closest('[data-blank-menu]')) setBlankMenu(null);
            if (e.pointerType !== 'touch' || !openFolder || !isBlank(e.target)) return;
            const x = e.clientX, y = e.clientY;
            clear();
            timer = setTimeout(() => {
                if (suppressNextClick.current) return;
                setBlankMenu({ x, y });
            }, 600);
        };
        const onKey = (e) => { if (e.key === 'Escape') setBlankMenu(null); };
        document.addEventListener('contextmenu', onContext);
        document.addEventListener('pointerdown', onDown);
        document.addEventListener('pointerup', clear);
        document.addEventListener('pointercancel', clear);
        document.addEventListener('keydown', onKey);
        window.addEventListener('scroll', clear, true);
        return () => {
            clear();
            document.removeEventListener('contextmenu', onContext);
            document.removeEventListener('pointerdown', onDown);
            document.removeEventListener('pointerup', clear);
            document.removeEventListener('pointercancel', clear);
            document.removeEventListener('keydown', onKey);
            window.removeEventListener('scroll', clear, true);
        };
    });
    const [moveSubmenuOpen, setMoveSubmenuOpen] = useState(false);
    const [clipboardFolder, setClipboardFolder] = useState(null);

    const pasteFolder = (parentId) => {
        if (!clipboardFolder) return;
        router.post(route('volunteer.file201.folders.copy', clipboardFolder.id), {
            parent_id: Number(parentId),
        }, { preserveScroll: true });
    };
    const [clipboardDoc, setClipboardDoc] = useState(null);

    const pasteDoc = (folderId) => {
        if (!clipboardDoc) return;
        router.post(route('volunteer.file201.documents.copy', clipboardDoc.id), {
            folder_id: Number(folderId),
        }, { preserveScroll: true });
    };

    const bindLongPress = (onOpen) => ({
        onPointerDown: (e) => {
            if (e.pointerType !== 'touch') return;
            const x = e.clientX;
            const y = e.clientY;
            clearTimeout(longPressTimer.current);
            longPressTimer.current = setTimeout(() => {
                if (selected.length > 0) return;
                suppressNextClick.current = true;
                setMoveSubmenuOpen(false);
                onOpen(x, y);
                setTimeout(() => { suppressNextClick.current = false; }, 500);
            }, 450);
        },
        onPointerUp: () => clearTimeout(longPressTimer.current),
        onPointerLeave: () => clearTimeout(longPressTimer.current),
        onPointerCancel: () => clearTimeout(longPressTimer.current),
    });

    /* ---- Multi-select (Shift/Ctrl+click) ---- */
    const [selected, setSelected] = useState([]);

    const [barMoveOpen, setBarMoveOpen] = useState(false);
    const [barPoint] = useState(() => ({ x: null, y: null }));
    useEffect(() => {
        const onClick = (e) => { barPoint.x = e.clientX; barPoint.y = e.clientY; };
        document.addEventListener('click', onClick, true);
        return () => document.removeEventListener('click', onClick, true);
    }, []);
    const clearSelection = () => {
        setBarMoveOpen(false);
        setSelected([]);
        document.querySelectorAll('.f201-selected').forEach(el => el.classList.remove('f201-selected'));
    };

    const moveSelected = (target) => {
        const tid = target === 'top' ? null : Number(target);
        const list = selected.filter(s => !(s.kind === 'folder' && tid !== null && (s.item.id === tid || getDescendantFolderIds(s.item.id).includes(tid))));
        runSeq(list, (s, next) => {
            if (s.kind === 'folder') {
                router.patch(route('volunteer.file201.folders.move', s.item.id), { parent_id: tid }, { preserveScroll: true, onFinish: next });
            } else {
                router.patch(route('volunteer.file201.documents.move', s.item.id), { folder_id: tid }, { preserveScroll: true, onFinish: next });
            }
        });
        clearSelection();
    };

    const selectedAllFiles = () => {
        const out = new Map();
        selected.forEach(s => {
            if (s.kind === 'doc') out.set(s.item.id, s.item);
            else {
                const ids = [s.item.id, ...getDescendantFolderIds(s.item.id)];
                allIndividualFiles.filter(d => ids.includes(d.folder_id)).forEach(d => out.set(d.id, d));
            }
        });
        return Array.from(out.values());
    };

    useEffect(() => {
        const onCtx = (e) => {
            if (!selected.length) return;
            e.preventDefault();
            setMoveSubmenuOpen(false);
            setActionMenu({ kind: 'multi', x: e.clientX, y: e.clientY });
        };
        document.addEventListener('contextmenu', onCtx);
        return () => document.removeEventListener('contextmenu', onCtx);
    }, [selected]);

    useEffect(() => {
        const ctxAnywhere = true;
        let t = null;
        const cancel = () => clearTimeout(t);
        const onDown = (e) => {
            if (e.pointerType !== 'touch' || !selected.length) return;
            if (e.target && e.target.closest && e.target.closest('input, textarea, select')) return;
            const x = e.clientX;
            const y = e.clientY;
            clearTimeout(t);
            t = setTimeout(() => {
                suppressNextClick.current = true;
                setMoveSubmenuOpen(false);
                setActionMenu({ kind: 'multi', x, y });
                setTimeout(() => { suppressNextClick.current = false; }, 500);
            }, 450);
        };
        document.addEventListener('pointerdown', onDown);
        document.addEventListener('pointerup', cancel);
        document.addEventListener('pointercancel', cancel);
        return () => {
            cancel();
            document.removeEventListener('pointerdown', onDown);
            document.removeEventListener('pointerup', cancel);
            document.removeEventListener('pointercancel', cancel);
        };
    }, [selected]);

    useEffect(() => {
        const onDown = (e) => {
            if (e.shiftKey && e.target && e.target.closest && e.target.closest('.f201-card, .f201-folder, .f201-row, [role="button"]')) e.preventDefault();
        };
        document.addEventListener('mousedown', onDown);
        return () => document.removeEventListener('mousedown', onDown);
    }, []);

    useEffect(() => {
        const onKey = (e) => { if (e.key === 'Escape' && selected.length > 0) clearSelection(); };
        document.addEventListener('keydown', onKey);
        return () => document.removeEventListener('keydown', onKey);
    }, [selected]);

    const selClickFlag = useRef(false);
    useEffect(() => {
        const onDocClick = () => {
            setTimeout(() => {
                if (selClickFlag.current) { selClickFlag.current = false; return; }
                if (selected.length > 0 && !actionMenu) clearSelection();
            }, 0);
        };
        document.addEventListener('click', onDocClick);
        return () => document.removeEventListener('click', onDocClick);
    }, [selected, actionMenu]);

    const guardClick = (fn, sel) => (...args) => {
        if (sel || suppressNextClick.current) selClickFlag.current = true;
        if (suppressNextClick.current) { suppressNextClick.current = false; return; }
        const ev = args[0];
        if (sel && ev && (ev.shiftKey || ev.ctrlKey || ev.metaKey || selected.length > 0)) {
            if (selected.length > 0 && selected[0].section && sel.section && selected[0].section !== sel.section) { if (ev.preventDefault) ev.preventDefault(); return; }
            if (ev.preventDefault) ev.preventDefault();
            if (window.getSelection) window.getSelection().removeAllRanges();
            const exists = selected.some(s => s.kind === sel.kind && s.item.id === sel.item.id);
            if (ev.currentTarget && ev.currentTarget.classList) ev.currentTarget.classList[exists ? 'remove' : 'add']('f201-selected');
            setSelected(prev => exists
                ? prev.filter(s => !(s.kind === sel.kind && s.item.id === sel.item.id))
                : [...prev, sel]);
            return;
        }
        fn(...args);
    };

    const closeActionMenu = () => { setActionMenu(null); setMoveSubmenuOpen(false); };

    const openFolderMenu = (folder, x, y) => {
        setActionMenu({ kind: 'folder', item: folder, x, y });
    };

    const openFileMenu = (doc, x, y, canMove, moveFolders, noStar) => {
        setActionMenu({ kind: 'file', item: doc, x, y, canMove, moveFolders: moveFolders || [], noStar: !!noStar });
    };

    /* Move every file inside an approved-request GROUP to a folder in one go. */
    const moveGroupDocs = (files, folderId) => {
        (files || []).forEach((f) => {
            if (!f.has_file && !f.id) return;
            router.patch(route('volunteer.file201.documents.move', f.id), {
                folder_id: folderId === '' ? null : Number(folderId),
            }, { preserveScroll: true });
        });
    };

    const downloadAllApprovedFiles = (files) => {
        files.forEach((f, i) => {
            setTimeout(() => {
                if (!f.has_file) return;
                const link = document.createElement('a');
                link.href = route('volunteer.file201.approved.download', f.id);
                link.download = '';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }, i * 500);
        });
    };

    /* ---- Multi-file (group) actions ---- */
    const [clipboardDocs, setClipboardDocs] = useState([]);

    const runSeq = (list, send, i = 0) => {
        if (i >= list.length) return;
        send(list[i], () => runSeq(list, send, i + 1));
    };

    const moveGroupSeq = (files, folderId) => {
        runSeq((files || []).filter(f => f.id), (f, next) => {
            router.patch(route('volunteer.file201.documents.move', f.id), {
                folder_id: folderId === '' ? null : Number(folderId),
            }, { preserveScroll: true, onFinish: next });
        });
    };

    const pasteDocs = (folderId) => {
        if (!clipboardDocs.length) return;
        runSeq(clipboardDocs, (f, next) => {
            router.post(route('volunteer.file201.documents.copy', f.id), {
                folder_id: Number(folderId),
            }, { preserveScroll: true, onFinish: next });
        });
    };

    const openGroupMenu = (group, files, x, y) => {
        setActionMenu({ kind: 'group', item: group, files, x, y, moveFolders: folderOptions });
    };

    const kebab = (onOpen) => (
        <button
            type="button"
            aria-label="More actions"
            className="f201-icon-btn"
            onPointerDown={(e) => e.stopPropagation()}
            onClick={(e) => {
                e.stopPropagation();
                const r = e.currentTarget.getBoundingClientRect();
                setMoveSubmenuOpen(false);
                onOpen(r.right - 100, r.bottom - 14);
            }}
            style={{ marginLeft: 'auto', flexShrink: 0, width: '28px', height: '28px', border: 'none', background: 'transparent', borderRadius: '50%', cursor: 'pointer', display: 'flex', alignItems: 'center', justifyContent: 'center', color: '#555' }}
        >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/></svg>
        </button>
    );

    const cardStyle = { background: 'white', borderRadius: '10px', border: '1px solid #ebebeb', overflow: 'hidden' };
    const labelStyle = { fontSize: '11px', fontWeight: '600', color: '#888', display: 'block', marginBottom: '6px' };
    const fieldStyle = { width: '100%', padding: '9px 12px', border: '1px solid #ddd', borderRadius: '8px', fontSize: '12px', background: 'white', color: '#111', fontFamily: 'inherit' };
    const sectionTitle = { fontSize: '12px', fontWeight: '600', color: '#111' };
    const subheading = { fontSize: '13px', fontWeight: '700', color: '#111' };

    const emptyState = (text) => (
        <div style={{ ...cardStyle, padding: '40px 20px', textAlign: 'center' }}>
            <div style={{ width: '44px', height: '44px', borderRadius: '10px', background: '#f5f5f5', display: 'flex', alignItems: 'center', justifyContent: 'center', margin: '0 auto 12px' }}>
                <FileIcon color="#ccc" size={20} />
            </div>
            <div style={{ fontSize: '11.5px', color: '#aaa' }}>{text}</div>
        </div>
    );

    return (
        <VolunteerShell active="file201" title="201 File">

            <style>{`
                .f201-row:hover { background: #fafafa; }
                .f201-name-link:hover { text-decoration: underline !important; }
                .f201-icon-btn:hover { background: #f2f2f2 !important; }
                .f201-folder:hover { border-color: #d5d5d5 !important; }
                .f201-card:hover { border-color: #d5d5d5 !important; }
                .f201-selected { background: #fdecec !important; outline: 2px solid #CC0000; outline-offset: -2px; border-radius: 8px; }
                .f201-card, .f201-folder, .f201-row, .f201-selected, .f201-selected * { user-select: none; }
                .f201-card, .f201-folder, .f201-row { -webkit-touch-callout: none; }
                @media (pointer: coarse) { .f201-name-link { pointer-events: none; } }
            `}</style>

            {uploadSuccessMsg && (                 <div style={{ background: '#f0fdf4', border: '1px solid #bbf7d0', color: '#16a34a', borderRadius: '8px', padding: '10px 14px', fontSize: '12px', fontWeight: 600, marginBottom: '14px' }}>                     {uploadSuccessMsg}                 </div>             )}
            {/* Header */}
            <div style={{ marginBottom: '20px' }}>
                <div style={{ fontSize: '14px', fontWeight: '700', color: '#111' }}>201 File</div>
                <div style={{ fontSize: '11px', color: '#aaa', marginTop: '2px' }}>Your approved files, folders, and document requests - all in one place.</div>
            </div>

            {/* ============================================================ */}
            {/* DOCUMENT REQUESTS (from admin)                                 */}
            {/* ============================================================ */}
            <div style={{ ...subheading, margin: '28px 0 10px' }}>Document Requests</div>
            <div style={{ display: 'flex', flexDirection: 'column', gap: '10px' }}>
                {activeRequests.length === 0 ? emptyState('No document requests from the admin yet.') : activeRequests.map(req => {
                    const uploads = req.uploads || [];
                    const uploadCount = uploads.length;
                    const approvedCount = uploads.filter(u => u.status === 'approved').length;
                    const rejectedCount = uploads.filter(u => u.status === 'rejected').length;
                    const submittedCount = uploads.filter(u => u.status === 'pending' || u.status === 'needs_revision').length;
                    const isFullyApproved = uploadCount > 0 && approvedCount === uploadCount;
                    const isExpanded = expandedRequestId === req.id;

                    return (
                        <div
                            key={req.id}
                            className="f201-card"
                            onClick={() => setExpandedRequestId(isExpanded ? null : req.id)}
                            style={{ background: 'white', border: '1px solid #ebebeb', borderRadius: '10px', overflow: 'hidden', cursor: 'pointer' }}
                        >
                            <div style={{ display: 'flex', alignItems: 'center', gap: '12px', padding: '14px 16px' }}>
                                <div style={{ flex: '1 1 auto', minWidth: 0 }}>
                                    <div style={{ fontSize: '12.5px', fontWeight: 600, color: '#111', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                                        {req.document_name}
                                    </div>
                                    <div style={{ fontSize: '10.5px', color: '#aaa', marginTop: '3px', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                                        {req.due_date ? `Due ${fmtDate(req.due_date)}` : 'No due date'}
                                    </div>
                                </div>
                                <div style={{ flexShrink: 0, display: 'flex', alignItems: 'center', gap: '10px' }}>
                                    {uploadCount === 0 ? null : isFullyApproved ? (
                                        <span style={{ fontSize: '10px', fontWeight: 700, padding: '3px 9px', borderRadius: '20px', background: '#f0fdf4', color: '#16a34a', whiteSpace: 'nowrap' }}>
                                            &#10003; Approved
                                        </span>
                                    ) : (
                                        <span style={{ fontSize: '10px', fontWeight: 700, padding: '3px 9px', borderRadius: '20px', background: '#fff7e0', color: '#96720b', whiteSpace: 'nowrap' }}>
                                            {(req.max_files > 0 && uploads.filter(u => u.status === 'pending' || u.status === 'approved').length < req.max_files) ? (uploads.filter(u => u.status === 'pending' || u.status === 'approved').length + ' of ' + req.max_files + ' uploaded') : 'Submitted'}
                                        </span>
                                    )}
                                    <ChevronIcon open={isExpanded} />
                                </div>
                            </div>

                            {isExpanded && (
                                <div onClick={(e) => e.stopPropagation()} style={{ borderTop: '1px solid #f5f5f5', padding: '14px 16px 16px', background: '#fdfdfd' }}>
                                    <Field label="Instructions" value={req.instructions || '-'} />
                                    <Field label="Requested by" value={req.requested_by || '-'} last={true} />

                                    <div style={{ marginTop: '12px' }}>
                                        {(uploadCount === 0 || rejectedCount > 0) && (
                                        <button
                                            type="button"
                                            onClick={(e) => { e.stopPropagation(); openUploadForRequest(req); }}
                                            style={{ background: '#CC0000', color: '#fff', border: 'none', padding: '7px 16px', borderRadius: '6px', fontSize: '11px', fontWeight: 600, cursor: 'pointer', fontFamily: 'inherit' }}
                                        >
                                            Upload
                                        </button>
                                        )}
                                    </div>
                                </div>
                            )}
                        </div>
                    );
                })}
            </div>

            {/* ============================================================ */}
            {/* 1. APPROVED / REJECTED (tabbed)                               */}
            {/* ============================================================ */}
            {archivePrompt && (
                <div
                    onClick={() => setArchivePrompt(null)}
                    style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.4)', display: 'flex', alignItems: 'center', justifyContent: 'center', zIndex: 1000 }}
                >
                    <div
                        onClick={(e) => e.stopPropagation()}
                        style={{ background: 'white', borderRadius: '12px', padding: '20px', maxWidth: '380px', width: '90%', boxShadow: '0 10px 30px rgba(0,0,0,0.2)' }}
                    >
                        <div style={{ fontSize: '13.5px', fontWeight: 700, color: '#111', marginBottom: '8px' }}>
                            {'Cannot delete "' + archivePrompt.name + '"'}
                        </div>
                        <div style={{ fontSize: '12px', color: '#555', lineHeight: 1.5, marginBottom: '16px' }}>
                            {"Files can't be deleted. Move them to the Archive first. Files inside its subfolders will be moved too."}
                        </div>
                        <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '8px' }}>
                            <button
                                type="button"
                                onClick={() => setArchivePrompt(null)}
                                style={{ padding: '8px 14px', borderRadius: '8px', border: '1px solid #ddd', background: 'white', color: '#333', fontSize: '12px', fontWeight: 600, cursor: 'pointer' }}
                            >Cancel</button>
                            <button
                                type="button"
                                onClick={confirmArchiveFolder}
                                style={{ padding: '8px 14px', borderRadius: '8px', border: 'none', background: '#CC0000', color: 'white', fontSize: '12px', fontWeight: 600, cursor: 'pointer' }}
                            >Move to Archive</button>
                        </div>
                    </div>
                </div>
            )}

            <div id="approved-section" style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: '12px', flexWrap: 'wrap', margin: '28px 0 12px' }}>
                <span style={subheading}>Approved Files &amp; Folders</span>
            </div>

            <div style={{ display: 'flex', gap: '8px', flexWrap: 'wrap', marginBottom: '16px' }}>
                <StatusTabButton active={statusTab === 'pending'} onClick={() => setStatusTab('pending')} label="Pending" count={pendingUploads.length} activeColor="#b45309" />
                <StatusTabButton active={statusTab === 'approved'} onClick={() => setStatusTab('approved')} label="Approved" count={unfiled.length} activeColor="#16a34a" />
                <StatusTabButton active={statusTab === 'rejected'} onClick={() => setStatusTab('rejected')} label="Rejected" count={rejectedUploads.length} activeColor="#cc0000" />
            </div>

            {statusTab === 'pending' && (
                <div style={{ display: 'flex', flexDirection: 'column', gap: '6px' }}>
                    {pendingGroups.length === 0 ? emptyState('No pending files right now.') : pendingMonths.map((month, monthIdx) => {
                        const isCollapsed = monthIdx === 0 ? collapsedPendingMonths.has(month.key) : !collapsedPendingMonths.has(month.key);
                        return (
                            <div key={month.key} style={{ marginBottom: '4px' }}>
                                <MonthHeader
                                    label={month.label}
                                    count={month.items.length}
                                    collapsed={isCollapsed}
                                    onClick={() => toggleMonth(month.key, setCollapsedPendingMonths)}
                                />
                                {!isCollapsed && (
                                    <div style={{ display: 'flex', flexDirection: 'column', gap: '10px', marginBottom: '10px' }}>
                                        {month.items.map(g => {
                                            const isExpanded = expandedPendingKey === g.request.id;
                                            return (
                                                <div
                                                    key={g.request.id}
                                                    className="f201-card"
                                                    onClick={() => setExpandedPendingKey(isExpanded ? null : g.request.id)}
                                                    style={{ background: 'white', border: '1px solid #ebebeb', borderRadius: '10px', overflow: 'hidden', cursor: 'pointer' }}
                                                >
                                                    <div style={{ display: 'flex', alignItems: 'center', gap: '12px', padding: '14px 16px' }}>
                                                        <div style={{ flex: '1 1 auto', minWidth: 0 }}>
                                                            <div style={{ fontSize: '12.5px', fontWeight: 600, color: '#111', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{g.request.document_name}</div>
                                                            <div style={{ fontSize: '10.5px', color: '#aaa', marginTop: '3px' }}>{fmtDate(g.latestDate)}</div>
                                                        </div>
                                                        <div style={{ flexShrink: 0, display: 'flex', alignItems: 'center', gap: '10px' }}>
                                                            <span style={{ fontSize: '10px', fontWeight: 700, padding: '3px 9px', borderRadius: '20px', background: '#fff7e0', color: '#96720b', whiteSpace: 'nowrap' }}>
                                                                {g.files.length} File{g.files.length !== 1 ? 's' : ''}
                                                            </span>
                                                            <ChevronIcon open={isExpanded} />
                                                        </div>
                                                    </div>
                                                    {isExpanded && (
                                                        <div onClick={(e) => e.stopPropagation()} style={{ borderTop: '1px solid #f5f5f5', padding: '14px 16px 16px', background: '#fdfdfd' }}>
                                                            {g.files.map((f, i) => (
                                                                <div key={f.id} style={{ padding: '9px 0', borderBottom: i < g.files.length - 1 ? '1px solid #f5f5f5' : 'none', cursor: pendingViewHref(f) ? 'pointer' : 'default' }} onClick={guardClick(() => { const href = pendingViewHref(f); if (href) window.open(href, '_blank', 'noopener'); }, { kind: 'doc', section: 'pending', item: f })}>
                                                                    <div style={{ fontSize: '12px', fontWeight: 600, color: '#111' }}>{f.original_name}</div>
                                                                    <div style={{ fontSize: '11px', color: '#999', marginTop: '4px' }}>Still waiting for admin review.</div>
                                                                </div>
                                                            ))}
                                                        </div>
                                                    )}
                                                </div>
                                            );
                                        })}
                                    </div>
                                )}
                            </div>
                        );
                    })}
                </div>
            )}

            {statusTab === 'approved' && (
                <>
                    <div style={{ display: 'flex', flexDirection: 'column', gap: '6px' }}>
                        {unfiled.length === 0
                            ? emptyState('No new approved files. Once your document is approved, it will appear here so you can move it to a folder.')
                            : approvedMonths.map((month, monthIdx) => {
                                const isCollapsed = monthIdx === 0 ? collapsedApprovedMonths.has(month.key) : !collapsedApprovedMonths.has(month.key);
                                return (
                                    <div key={month.key} style={{ marginBottom: '4px' }}>
                                        <MonthHeader
                                            label={month.label}
                                            count={month.items.length}
                                            collapsed={isCollapsed}
                                            onClick={() => toggleMonth(month.key, setCollapsedApprovedMonths)}
                                        />
                                        {!isCollapsed && (
                                            <div style={{ display: 'flex', flexDirection: 'column', gap: '10px', marginBottom: '10px' }}>
                                                {month.items.map(d => {
                                                    if (d.is_group) {
                                                        const isExpanded = expandedApprovedKey === d.id;
                                                        const groupFiles = d.files.filter(f => !f.folder_id);
                                                        return (
                                                            <div
                                                                key={d.id}
                                                                className="f201-card"
                                                                onClick={guardClick(() => setExpandedApprovedKey(isExpanded ? null : d.id))}
                                                                style={{ background: 'white', border: '1px solid #ebebeb', borderRadius: '10px', overflow: 'hidden', cursor: 'pointer' }}
                                                            >
                                                                <div style={{ display: 'flex', alignItems: 'center', gap: '12px', padding: '14px 16px' }}>
                                                                    <div style={{ flex: '1 1 auto', minWidth: 0 }}>
                                                                        <div style={{ fontSize: '12.5px', fontWeight: 600, color: '#111', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{d.name}</div>
                                                                        <div style={{ fontSize: '10.5px', color: '#aaa', marginTop: '3px' }}>{fmtDate(d.date)}</div>
                                                                    </div>
                                                                    <div style={{ flexShrink: 0, display: 'flex', alignItems: 'center', gap: '10px' }}>
                                                                        <span style={{ fontSize: '10px', fontWeight: 700, padding: '3px 9px', borderRadius: '20px', background: '#f5f5f5', color: '#999', whiteSpace: 'nowrap' }}>
                                                                            {d.files.length} File{d.files.length !== 1 ? 's' : ''}
                                                                        </span>
                                                                        <ChevronIcon open={isExpanded} />
                                                                    </div>
                                                                </div>
                                                                {isExpanded && (
                                                                    <div onClick={(e) => e.stopPropagation()} style={{ borderTop: '1px solid #f5f5f5', padding: '14px 16px 16px', background: '#fdfdfd' }}>
                                                                        {groupFiles.length === 0 ? (
                                                                            <div style={{ fontSize: '11.5px', color: '#aaa', textAlign: 'center', padding: '10px 0' }}>All files have been moved to folders.</div>
                                                                        ) : groupFiles.map((f, i) => (
                                                                            <div key={f.id} style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: '10px', padding: '9px 10px', borderRadius: '8px', cursor: 'pointer', borderBottom: i < groupFiles.length - 1 ? '1px solid #f5f5f5' : 'none' }} onClick={guardClick(() => { const href = approvedViewHref(f); if (href) window.open(href, '_blank', 'noopener'); }, { kind: 'doc', section: 'approved', item: f })} {...bindLongPress((x, y) => openFileMenu(f, x, y, true, folderOptions, true))}>
                                                                                <div style={{ flex: '1 1 auto', minWidth: 0 }}><FileNameLink doc={f} /></div>
                                                                                {kebab((x, y) => openFileMenu(f, x, y, true, folderOptions, true))}
                                                                            </div>
                                                                        ))}
                                                                    </div>
                                                                )}
                                                            </div>
                                                        );
                                                    }

                                                    const href = approvedViewHref(d);
                                                    return (
                                                        <div
                                                            key={d.id}
                                                            className="f201-card"
                                                            onClick={guardClick(() => { if (href) window.open(href, '_blank', 'noopener'); }, { kind: 'doc', section: 'approved', item: d })}
                                                            {...bindLongPress((x, y) => openFileMenu(d, x, y, false, undefined, true))}
                                                            style={{ background: 'white', border: '1px solid #ebebeb', borderRadius: '10px', overflow: 'hidden', cursor: href ? 'pointer' : 'default', display: 'flex', alignItems: 'center', gap: '12px', padding: '14px 16px' }}
                                                        >
                                                            <div style={{ flex: '1 1 auto', minWidth: 0 }}>
                                                                <div style={{ fontSize: '12.5px', fontWeight: 600, color: '#111', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{d.name}</div>
                                                                <div style={{ fontSize: '10.5px', color: '#aaa', marginTop: '3px' }}>{fmtDate(d.date)}</div>
                                                            </div>
                                                            {kebab((x, y) => openFileMenu(d, x, y, false, undefined, true))}
                                                        </div>
                                                    );
                                                })}
                                            </div>
                                        )}
                                    </div>
                                );
                            })}
                    </div>
                    {unfiled.length > 0 && folderList.length === 0 && (
                        <div style={{ fontSize: '10.5px', color: '#b45309', marginTop: '8px' }}>
                            You have no folders yet. Create one under "My Folders" below so you have somewhere to move files.
                        </div>
                    )}
                </>
            )}

            {statusTab === 'rejected' && (
                <div style={{ display: 'flex', flexDirection: 'column', gap: '6px' }}>
                    {rejectedGroups.length === 0 ? emptyState('No rejected files right now.') : rejectedMonths.map((month, monthIdx) => {
                        const isCollapsed = monthIdx === 0 ? collapsedRejectedMonths.has(month.key) : !collapsedRejectedMonths.has(month.key);
                        return (
                            <div key={month.key} style={{ marginBottom: '4px' }}>
                                <MonthHeader
                                    label={month.label}
                                    count={month.items.length}
                                    collapsed={isCollapsed}
                                    onClick={() => toggleMonth(month.key, setCollapsedRejectedMonths)}
                                />
                                {!isCollapsed && (
                                    <div style={{ display: 'flex', flexDirection: 'column', gap: '10px', marginBottom: '10px' }}>
                                        {month.items.map(g => {
                                            const isExpanded = expandedRejectedKey === g.request.id;
                                            return (
                                                <div
                                                    key={g.request.id}
                                                    className="f201-card"
                                                    onClick={() => setExpandedRejectedKey(isExpanded ? null : g.request.id)}
                                                    style={{ background: 'white', border: '1px solid #ebebeb', borderRadius: '10px', overflow: 'hidden', cursor: 'pointer' }}
                                                >
                                                    <div style={{ display: 'flex', alignItems: 'center', gap: '12px', padding: '14px 16px' }}>
                                                        <div style={{ flex: '1 1 auto', minWidth: 0 }}>
                                                            <div style={{ fontSize: '12.5px', fontWeight: 600, color: '#111', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{g.request.document_name}</div>
                                                            <div style={{ fontSize: '10.5px', color: '#aaa', marginTop: '3px' }}>{fmtDate(g.latestDate)}</div>
                                                        </div>
                                                        <div style={{ flexShrink: 0, display: 'flex', alignItems: 'center', gap: '10px' }}>
                                                            <span style={{ fontSize: '10px', fontWeight: 700, padding: '3px 9px', borderRadius: '20px', background: '#fdecec', color: '#CC0000', whiteSpace: 'nowrap' }}>
                                                                {g.files.length} File{g.files.length !== 1 ? 's' : ''}
                                                            </span>
                                                            <ChevronIcon open={isExpanded} />
                                                        </div>
                                                    </div>
                                                    {isExpanded && (
                                                        <div onClick={(e) => e.stopPropagation()} style={{ borderTop: '1px solid #f5f5f5', padding: '14px 16px 16px', background: '#fdfdfd' }}>
                                                            {g.files.map((f, i) => (
                                                                <div key={f.id} style={{ padding: '9px 0', borderBottom: i < g.files.length - 1 ? '1px solid #f5f5f5' : 'none' }}>
                                                                    <div style={{ fontSize: '12px', fontWeight: 600, color: '#111' }}>{f.original_name}</div>
                                                                    <div style={{ fontSize: '11px', color: '#999', marginTop: '4px' }}>{f.admin_remarks ? `"${f.admin_remarks}"` : 'No remarks'}</div>
                                                                </div>
                                                            ))}
                                                            <div style={{ marginTop: '12px', paddingTop: '12px', borderTop: '1px solid #f5f5f5' }}>
                                                                <button
                                                                    onClick={() => openUploadForRequest(g.request)}
                                                                    style={{ background: '#CC0000', color: '#fff', border: 'none', padding: '6px 13px', borderRadius: '6px', fontSize: '11px', fontWeight: 600, cursor: 'pointer', fontFamily: 'inherit' }}
                                                                >
                                                                    Re-upload
                                                                </button>
                                                            </div>
                                                        </div>
                                                    )}
                                                </div>
                                            );
                                        })}
                                    </div>
                                )}
                            </div>
                        );
                    })}
                </div>
            )}

            <>
                    {/* My Folders */}
                    <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: '10px', flexWrap: 'wrap', margin: '24px 0 10px' }}>
                        <div style={{ display: 'flex', alignItems: 'center', flexWrap: 'wrap', gap: '4px' }}>
                            {(openFolder || archiveOpen) && (
                                <button
                                    type="button"
                                    onClick={() => navigateToFolder(openFolder ? (openFolder.parent_id || null) : null)}
                                    title="Back"
                                    style={{
                                        display: 'inline-flex', alignItems: 'center', justifyContent: 'center',
                                        width: '24px', height: '24px', borderRadius: '6px', border: '1px solid #e0e0e0',
                                        background: 'white', color: '#333', cursor: 'pointer', marginRight: '6px', flexShrink: 0,
                                    }}
                                >
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><polyline points="15 18 9 12 15 6"/></svg>
                                </button>
                            )}
                            <span
                                onClick={() => navigateToFolder(null)}
                                style={{ ...sectionTitle, cursor: (openFolder || archiveOpen) ? 'pointer' : 'default', color: (openFolder || archiveOpen) ? '#888' : '#111' }}
                            >My Folders</span>
                            {archiveOpen && (<span style={{ display: 'flex', alignItems: 'center', gap: '4px' }}><span style={{ color: '#ccc', fontSize: '11px' }}>/</span><span style={sectionTitle}>Archive</span></span>)}
                            {breadcrumb.map((f, i) => (
                                <span key={f.id} style={{ display: 'flex', alignItems: 'center', gap: '4px' }}>
                                    <span style={{ color: '#ccc', fontSize: '11px' }}>/</span>
                                    <span
                                        onClick={() => i < breadcrumb.length - 1 && navigateToFolder(f.id)}
                                        style={{
                                            ...sectionTitle,
                                            cursor: i < breadcrumb.length - 1 ? 'pointer' : 'default',
                                            color: i < breadcrumb.length - 1 ? '#888' : '#111',
                                        }}
                                    >{f.name}</span>
                                </span>
                            ))}
                        </div>
                        <div data-folder-actions="1" style={{ display: 'flex', gap: '8px' }}>
                            <button type="button" onClick={() => setShowNewFolder(s => !s)} style={{
                                background: 'white', color: '#CC0000', border: '1px solid #f5c6c6', borderRadius: '8px',
                                padding: '6px 12px', fontSize: '10.5px', fontWeight: '600', cursor: 'pointer', fontFamily: 'inherit',
                            }}>+ New {openFolder ? 'Subfolder' : 'Folder'}</button>
                        </div>
                    </div>

                    {blankMenu && openFolder && (
                        <div data-blank-menu="1" style={{ position: 'fixed', left: Math.min(blankMenu.x, window.innerWidth - 210), top: Math.min(blankMenu.y, window.innerHeight - 110), zIndex: 9999, background: '#fff', border: '1px solid #eee', borderRadius: '10px', boxShadow: '0 8px 24px rgba(0,0,0,0.15)', minWidth: '190px', overflow: 'hidden' }}>
                            {(clipboardFolder || clipboardDoc || clipboardDocs.length > 0) && (
                                <button type="button" style={{ display: 'flex', alignItems: 'center', gap: '8px', width: '100%', padding: '11px 14px', background: 'none', border: 'none', fontSize: '12.5px', textAlign: 'left', cursor: 'pointer', fontFamily: 'inherit' }} onClick={() => {
                                    setBlankMenu(null);
                                    if (clipboardDocs.length > 0) { pasteDocs(openFolder.id); }
                                    else if (clipboardDoc) { pasteDoc(openFolder.id); }
                                    else if (clipboardFolder) {
                                        if (clipboardFolder.id === openFolder.id || getDescendantFolderIds(clipboardFolder.id).includes(openFolder.id)) { alert("You can't paste a folder into itself or its own subfolder."); return; }
                                        pasteFolder(openFolder.id);
                                    }
                                }}>
                                    <Ico n="paste" />
                                    {clipboardDocs.length > 1 ? `Paste ${clipboardDocs.length} files` : 'Paste'}
                                </button>
                            )}
                            <button type="button" style={{ display: 'flex', alignItems: 'center', gap: '8px', width: '100%', padding: '11px 14px', background: 'none', border: 'none', borderTop: (clipboardFolder || clipboardDoc || clipboardDocs.length > 0) ? '1px solid #f5f5f5' : 'none', fontSize: '12.5px', textAlign: 'left', cursor: 'pointer', fontFamily: 'inherit' }} onClick={() => { setBlankMenu(null); setShowNewFolder(true); }}>
                                + New Subfolder
                            </button>
                        </div>
                    )}
                    {showNewFolder && (
                        <form onSubmit={handleCreateFolder} style={{ ...cardStyle, padding: '14px 16px', marginBottom: '12px', display: 'flex', gap: '8px', flexWrap: 'wrap', alignItems: 'flex-start' }}>
                            <div style={{ flex: '1 1 200px' }}>
                                <input
                                    type="text"
                                    className="vp-input"
                                    autoFocus
                                    maxLength={60}
                                    value={folderForm.data.name}
                                    onChange={e => folderForm.setData('name', e.target.value)}
                                    placeholder="Folder name (e.g. Certificates)"
                                    aria-label="Folder name"
                                    style={fieldStyle}
                                />
                                {folderForm.errors.name && <div style={{ fontSize: '10.5px', color: '#CC0000', marginTop: '4px' }}>{folderForm.errors.name}</div>}
                            </div>
                            <button
                                type="submit"
                                disabled={folderForm.processing || !folderForm.data.name.trim()}
                                className="btn-view"
                                style={{
                                    background: '#CC0000', color: 'white', border: 'none', borderRadius: '8px',
                                    padding: '9px 18px', fontSize: '11.5px', fontWeight: '600', fontFamily: 'inherit',
                                    cursor: (folderForm.processing || !folderForm.data.name.trim()) ? 'not-allowed' : 'pointer',
                                    opacity: (folderForm.processing || !folderForm.data.name.trim()) ? 0.5 : 1,
                                }}
                            >
                                Create
                            </button>
                            <button type="button" onClick={() => { setShowNewFolder(false); folderForm.reset(); }} style={{
                                background: 'white', color: '#666', border: '1px solid #ebebeb', borderRadius: '8px',
                                padding: '9px 16px', fontSize: '11.5px', fontWeight: '500', cursor: 'pointer', fontFamily: 'inherit',
                            }}>Cancel</button>
                        </form>
                    )}

                    {archiveOpen ? (
                        archivedList.length === 0 ? emptyState('No files in the Archive.') : (
                            <div style={{ display: 'flex', flexDirection: 'column', gap: '6px' }}>
                                <div style={{ fontSize: '11.5px', color: '#888', marginBottom: '4px' }}>
                                    Archived files can be viewed and downloaded, but they cannot be deleted.
                                </div>
                                {archiveMenu && (() => {
                                    const closeMenu = () => { setArchiveMenu(null); setArchiveMoveOpen(false); };
                                    const itemSt = { display: 'block', width: '100%', boxSizing: 'border-box', padding: '10px 14px', fontSize: '12.5px', color: '#111', textDecoration: 'none', background: 'white', border: 'none', borderBottom: '1px solid #f5f5f5', textAlign: 'left', cursor: 'pointer', fontFamily: 'inherit' };
                                    const doMove = (folderId) => { moveDoc(archiveMenu.item, folderId); closeMenu(); };
                                    return (
                                        <>
                                            <div
                                                onClick={closeMenu}
                                                onContextMenu={(e) => { e.preventDefault(); closeMenu(); }}
                                                style={{ position: 'fixed', top: 0, left: 0, right: 0, bottom: 0, zIndex: 1000 }}
                                            />
                                            <div
                                                onClick={(e) => e.stopPropagation()}
                                                style={{
                                                    position: 'fixed',
                                                    left: `${Math.max(8, Math.min(archiveMenu.x, window.innerWidth - 188))}px`,
                                                    top: `${Math.max(8, Math.min(archiveMenu.y, window.innerHeight - (archiveMoveOpen ? 280 : 150)))}px`,
                                                    width: '180px', maxHeight: '260px', overflowY: 'auto', zIndex: 1001, background: 'white', borderRadius: '10px',
                                                    border: '1px solid #ebebeb', display: 'flex', flexDirection: 'column',
                                                }}
                                            >
                                                {!archiveMoveOpen ? (
                                                    <>
                                                        <a href={approvedDownloadHref(archiveMenu.item)} download="" onClick={closeMenu} style={itemSt}>
                                                            <Ico n="download" />
                                                            Download
                                                        </a>
                                                        <button type="button" style={itemSt} onClick={() => { setClipboardDoc(archiveMenu.item); setClipboardDocs([]); setClipboardFolder(null); closeMenu(); }}>
                                                            <Ico n="copy" />
                                                            Copy
                                                        </button>
                                                        <button type="button" style={{ ...itemSt, borderBottom: 'none' }} onClick={() => setArchiveMoveOpen(true)}>
                                                            <Ico n="move" />
                                                            Move to folder
                                                        </button>
                                                    </>
                                                ) : (
                                                    <>
                                                        <button type="button" style={{ ...itemSt, fontWeight: 600 }} onClick={() => setArchiveMoveOpen(false)}>
                                                            <Ico n="back" />
                                                            Back
                                                        </button>
                                                        <button type="button" style={itemSt} onClick={() => doMove('')}>
                                                            Back to Approved / top-level
                                                        </button>
                                                        {folderOptions.length === 0 ? (
                                                            <div style={{ padding: '11px 14px', fontSize: '11.5px', color: '#aaa' }}>Create a folder first.</div>
                                                        ) : folderOptions.map(o => (
                                                            <button key={o.id} type="button" style={itemSt} onClick={() => doMove(o.id)}>
                                                                {o.name}
                                                            </button>
                                                        ))}
                                                    </>
                                                )}
                                            </div>
                                        </>
                                    );
                                })()}
                                {archivedList.map(d => (
                                    <div key={d.id} {...bindLongPress((x, y) => { if (!selected.length) setArchiveMenu({ item: d, x, y }); })} onClick={guardClick(() => { const href = approvedViewHref(d); if (href) window.open(href, '_blank', 'noopener'); }, { kind: 'doc', section: 'archive', item: d })} onContextMenu={(e) => { if (selected.length) return; e.preventDefault(); e.stopPropagation(); setArchiveMenu({ item: d, x: e.clientX, y: e.clientY }); }} style={{ ...cardStyle, padding: '10px 14px', display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: '12px', cursor: approvedViewHref(d) ? 'pointer' : 'default' }}>
                                        <div style={{ minWidth: 0 }}>
                                            <div style={{ fontSize: '12.5px', fontWeight: 600, color: '#111', overflow: 'hidden', textOverflow: 'ellipsis' }}>{d.name}</div>
                                            <div style={{ fontSize: '10.5px', color: '#aaa', marginTop: '2px' }}>
                                                Archived {d.archived_at ? new Date(d.archived_at).toLocaleDateString() : ''}
                                            </div>
                                        </div>
                                        {kebab((x, y) => setArchiveMenu({ item: d, x, y }))}
                                    </div>
                                ))}
                            </div>
                        )
                    ) : childFolders.length === 0 && folderFiles.length === 0 ? (
                        <div style={{ ...cardStyle, padding: '36px 20px', textAlign: 'center' }}>
                            <div style={{ fontSize: '11.5px', color: '#aaa' }}>
                                {openFolder
                                    ? 'This folder is empty. Create a subfolder or move approved files here from above.'
                                    : 'You have no folders yet. Create your own folder to organize your approved files.'}
                            </div>
                        </div>
                    ) : (
                        <>
                            {childFolders.length > 0 && (
                                <>
                                    {!openFolder && (() => {
                                        const starredFolders = folderList.filter(f => f.is_starred);
                                        const starredFiles = allIndividualFiles.filter(d => d.is_starred);
                                        if (starredFolders.length === 0 && starredFiles.length === 0) return null;
                                        const rowStyle = { display: 'flex', alignItems: 'center', gap: '10px', padding: '9px 0', cursor: 'pointer' };
                                        const nameStyle = { fontSize: '12.5px', fontWeight: 600, color: '#111', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' };
                                        return (
                                            <div style={{ ...cardStyle, padding: '10px 16px 6px', marginBottom: '12px' }}>
                                                <div style={{ fontSize: '10px', fontWeight: 700, color: '#999', textTransform: 'uppercase', letterSpacing: '0.3px', marginBottom: '2px' }}>{'\u2605'} Starred</div>
                                                {starredFolders.map(f => (
                                                    <div key={'sf' + f.id} style={rowStyle}
                                                        onClick={guardClick(() => navigateToFolder(f.id), { kind: 'folder', section: 'folders', item: f })}
                                                        {...bindLongPress((x, y) => openFolderMenu(f, x, y))}>
                                                        <span style={{ width: '28px', height: '28px', borderRadius: '8px', background: '#fffbeb', display: 'flex', alignItems: 'center', justifyContent: 'center', flexShrink: 0 }}>
                                                            <FolderIcon color="#F59E0B" size={14} />
                                                        </span>
                                                        <div style={nameStyle}>{f.name}</div>
                                                        {kebab((x, y) => openFolderMenu(f, x, y))}
                                                    </div>
                                                ))}
                                                {starredFiles.map(d => {
                                                    const href = approvedViewHref(d);
                                                    return (
                                                        <div key={'sd' + d.id} style={rowStyle}
                                                            onClick={guardClick(() => { if (href) window.open(href, '_blank', 'noopener'); }, { kind: 'doc', section: 'folders', item: d })}
                                                            {...bindLongPress((x, y) => openFileMenu(d, x, y, true, folderOptions))}>
                                                            <div style={nameStyle}>{d.original_name || d.name}</div>
                                                            {kebab((x, y) => openFileMenu(d, x, y, true, folderOptions))}
                                                        </div>
                                                    );
                                                })}
                                            </div>
                                        );
                                    })()}
                                    {(openFolder || childFolders.some(f => !f.is_starred)) && (
                                    <div style={{ ...cardStyle, padding: '4px 16px', marginBottom: folderFiles.length > 0 ? '16px' : 0 }}>
                                    {childFolders.filter(f => openFolder || !f.is_starred).map((f, idx, arr) => {
                                        const nestedIds = [f.id, ...getDescendantFolderIds(f.id)];
                                        const n = allIndividualFiles.filter(d => nestedIds.includes(d.folder_id)).length;
                                        const subCount = folderList.filter(sf => sf.parent_id === f.id).length;
                                        return (
                                            <div
                                                key={f.id}
                                                role="button"
                                                tabIndex={0}
                                                className="f201-folder"
                                                onClick={guardClick(() => navigateToFolder(f.id), { kind: 'folder', section: 'folders', item: f })}
                                                {...bindLongPress((x, y) => openFolderMenu(f, x, y))}
                                                onKeyDown={(e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); navigateToFolder(f.id); } }}
                                                style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: '10px', padding: '12px 0', cursor: 'pointer', fontFamily: 'inherit', borderBottom: idx < arr.length - 1 ? '1px solid #f5f5f5' : 'none' }}
                                            >
                                                <div style={{ display: 'flex', alignItems: 'center', gap: '10px', flex: '1 1 auto', minWidth: 0 }}>
                                                    <span style={{ width: '32px', height: '32px', borderRadius: '8px', background: '#fffbeb', display: 'flex', alignItems: 'center', justifyContent: 'center', flexShrink: 0 }}>
                                                        <FolderIcon color="#F59E0B" size={16} />
                                                    </span>
                                                    <div style={{ minWidth: 0 }}>
                                                        <div style={{ fontSize: '12.5px', fontWeight: 600, color: '#111', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{f.is_starred ? '\u2605 ' : ''}{f.name}</div>
                                                        <div style={{ fontSize: '10.5px', color: (n > 0 || subCount > 0) ? '#999' : '#ccc', marginTop: '2px' }}>
                                                            {subCount > 0 ? `${subCount} folder${subCount !== 1 ? 's' : ''}, ` : ''}{n} file{n !== 1 ? 's' : ''}
                                                        </div>
                                                    </div>
                                                </div>
                                                {kebab((x, y) => openFolderMenu(f, x, y))}
                                            </div>
                                        );
                                    })}
                                    </div>
                                    )}
                                </>
                            )}
                            {openFolder && (
                                <DataTable
                                    cardStyle={cardStyle}
                                    empty="No files here. Move approved files here from above."
                                    columns={['Document Name']}
                                    rowOnClick={folderFiles.map(d => guardClick(() => { const href = approvedViewHref(d); if (href) window.open(href, '_blank', 'noopener'); }, { kind: 'doc', section: 'folders', item: d }))}
                                    rowExtraProps={folderFiles.map(d => bindLongPress((x, y) => openFileMenu(d, x, y, true, folderOptions.filter(o => o.id !== openFolder.id))))}
                                    rows={folderFiles.map(d => [
                                        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: '10px' }}><div style={{ minWidth: 0 }}>
                                            <FileNameLink doc={d} />
                                            <div style={{ fontSize: '10.5px', color: '#999', marginTop: '4px' }}>{fmtDate(d.date)}</div>
                                        </div>{kebab((x, y) => openFileMenu(d, x, y, true, folderOptions.filter(o => o.id !== openFolder.id)))}</div>,
                                    ])}
                                    keys={folderFiles.map(d => d.id)}
                                />
                            )}
                        </>
                    )}
                    {!openFolder && !archiveOpen && (
                        <div
                            role="button"
                            tabIndex={0}
                            className="f201-folder"
                            onClick={() => { setOpenFolderId(null); clearSelection(); setShowNewFolder(false); setArchiveOpen(true); }}
                            style={{ ...cardStyle, padding: '12px 16px', marginTop: '12px', display: 'flex', alignItems: 'center', gap: '10px', cursor: 'pointer' }}
                        >
                            <span style={{ width: '32px', height: '32px', borderRadius: '8px', background: '#f3f4f6', display: 'flex', alignItems: 'center', justifyContent: 'center', flexShrink: 0 }}>
                                <FolderIcon color="#6b7280" size={16} />
                            </span>
                            <div style={{ minWidth: 0 }}>
                                <div style={{ fontSize: '12.5px', fontWeight: 600, color: '#111' }}>Archive</div>
                                <div style={{ fontSize: '10.5px', color: '#999', marginTop: '2px' }}>{archivedList.length} file{archivedList.length !== 1 ? 's' : ''} - view and download only</div>
                            </div>
                        </div>
                    )}
            </>

            {/* Upload modal for a Document Request -- up to 10 files, no category */}
            {activeRequest && (
                <div
                    role="dialog"
                    aria-modal="true"
                    style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.35)', display: 'flex', alignItems: 'center', justifyContent: 'center', zIndex: 50, padding: '16px' }}
                    onClick={closeUpload}
                >
                    <div style={{ ...cardStyle, width: '100%', maxWidth: '420px' }} onClick={e => e.stopPropagation()}>
                        <div style={{ padding: '14px 18px', borderBottom: '1px solid #f5f5f5', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                            <span style={sectionTitle}>Upload: {activeRequest.document_name}</span>
                            <button type="button" onClick={closeUpload} aria-label="Close upload form" style={{ background: 'none', border: 'none', cursor: 'pointer', color: '#aaa', fontSize: '14px', lineHeight: 1 }}>&times;</button>
                        </div>

                        {activeRequest.uploads && activeRequest.uploads.some(u => u.status === 'rejected') && (
                            <div style={{ margin: '14px 18px 0', padding: '10px 12px', background: '#fff7f0', border: '1px solid #fde3d0', borderRadius: '8px' }}>
                                <div style={{ fontSize: '10px', fontWeight: '700', color: '#b45309', textTransform: 'uppercase', letterSpacing: '0.3px', marginBottom: '8px' }}>
                                    Previous submission
                                </div>
                                {activeRequest.uploads
                                    .filter(u => u.status === 'rejected')
                                    .map(u => (
                                        <div key={u.id} style={{ fontSize: '11px', color: '#111', fontWeight: 600, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', marginBottom: '4px' }}>
                                            {u.original_name}
                                        </div>
                                    ))}
                            </div>
                        )}

                        <form onSubmit={handleUpload} style={{ padding: '18px' }}>
                            <label htmlFor="req-upload-file" style={labelStyle}>
                                Files <span style={{ color: '#ccc', fontWeight: '400' }}>(PDF, JPG, PNG -- max 5MB each, up to {maxFiles} file{maxFiles > 1 ? 's' : ''})</span>
                            </label>
                            <input
                                id="req-upload-file"
                                type="file"
                                multiple
                                accept=".pdf,.jpg,.jpeg,.png"
                                onChange={handleFilesChange}
                                style={{ width: '100%', padding: '7px 0', fontSize: '12px', marginBottom: '10px' }}
                            />
                            {uploadForm.data.files.length > 0 && (
                                <div style={{ marginBottom: '12px', border: '1px solid #eee', borderRadius: '8px', overflow: 'hidden' }}>
                                    {uploadForm.data.files.map((f, i) => (
                                        <div key={i} style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', padding: '6px 10px', fontSize: '11px', color: '#555', borderBottom: i < uploadForm.data.files.length - 1 ? '1px solid #f5f5f5' : 'none' }}>
                                            <span style={{ overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', maxWidth: '260px' }}>{f.name}</span>
                                            <button type="button" onClick={() => removeSelectedFile(i)} style={{ border: 'none', background: 'transparent', color: '#CC0000', fontWeight: '700', cursor: 'pointer', fontSize: '13px' }}>&times;</button>
                                        </div>
                                    ))}
                                </div>
                            )}
                            {overLimit && <div style={{ fontSize: '10.5px', color: '#CC0000', marginBottom: '10px' }}>{maxFiles} file{maxFiles > 1 ? 's' : ''} requested, but you selected {uploadForm.data.files.length}. Please remove the extra.</div>}
                            {underLimit && uploadForm.data.files.length > 0 && <div style={{ fontSize: '10.5px', color: '#b45309', marginBottom: '10px' }}>{uploadForm.data.files.length} of {requiredCount} file(s) selected. Please select all {requiredCount} file{requiredCount > 1 ? 's' : ''} before uploading.</div>}
                            {uploadForm.errors.files && <div style={{ fontSize: '10.5px', color: '#CC0000', marginBottom: '10px' }}>{uploadForm.errors.files}</div>}
                            <div style={{ display: 'flex', gap: '8px' }}>
                                <button
                                    type="submit"
                                    disabled={uploadForm.processing || uploadForm.data.files.length === 0 || overLimit || underLimit}
                                    className="btn-view"
                                    style={{
                                        background: '#CC0000', color: 'white', border: 'none', borderRadius: '8px',
                                        padding: '9px 20px', fontSize: '11.5px', fontWeight: '600', fontFamily: 'inherit',
                                        cursor: (uploadForm.processing || uploadForm.data.files.length === 0 || overLimit || underLimit) ? 'not-allowed' : 'pointer',
                                        opacity: (uploadForm.processing || uploadForm.data.files.length === 0 || overLimit || underLimit) ? 0.6 : 1,
                                    }}
                                >
                                    {uploadForm.processing ? 'Uploading...' : 'Upload'}
                                </button>
                                <button type="button" onClick={closeUpload} style={{
                                    background: 'white', color: '#666', border: '1px solid #ebebeb', borderRadius: '8px',
                                    padding: '9px 18px', fontSize: '11.5px', fontWeight: '500', cursor: 'pointer', fontFamily: 'inherit',
                                }}>Cancel</button>
                            </div>
                        </form>
                    </div>
                </div>
            )}

            {renameTarget && (
                <div
                    role="dialog"
                    aria-modal="true"
                    style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.35)', display: 'flex', alignItems: 'center', justifyContent: 'center', zIndex: 50, padding: '16px' }}
                    onClick={closeRename}
                >
                    <div style={{ ...cardStyle, width: '100%', maxWidth: '360px' }} onClick={e => e.stopPropagation()}>
                        <div style={{ padding: '14px 18px', borderBottom: '1px solid #f5f5f5', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                            <span style={sectionTitle}>Rename file</span>
                            <button type="button" onClick={closeRename} aria-label="Close" style={{ background: 'none', border: 'none', cursor: 'pointer', color: '#aaa', fontSize: '14px', lineHeight: 1 }}>&times;</button>
                        </div>
                        <div style={{ padding: '18px' }}>
                            <input
                                type="text"
                                value={renameValue}
                                onChange={(e) => setRenameValue(e.target.value)}
                                autoFocus
                                style={{ width: '100%', boxSizing: 'border-box', padding: '8px 10px', fontSize: '12.5px', border: '1px solid #ddd', borderRadius: '6px', marginBottom: '14px', fontFamily: 'inherit' }}
                            />
                            <div style={{ display: 'flex', gap: '8px' }}>
                                <button
                                    type="button"
                                    onClick={saveRename}
                                    disabled={renameSaving || !renameValue.trim()}
                                    style={{
                                        background: '#CC0000', color: 'white', border: 'none', borderRadius: '8px',
                                        padding: '9px 20px', fontSize: '11.5px', fontWeight: '600', fontFamily: 'inherit',
                                        cursor: (renameSaving || !renameValue.trim()) ? 'not-allowed' : 'pointer',
                                        opacity: (renameSaving || !renameValue.trim()) ? 0.6 : 1,
                                    }}
                                >
                                    {renameSaving ? 'Saving...' : 'Save'}
                                </button>
                                <button type="button" onClick={closeRename} style={{
                                    background: 'white', color: '#666', border: '1px solid #ebebeb', borderRadius: '8px',
                                    padding: '9px 18px', fontSize: '11.5px', fontWeight: '500', cursor: 'pointer', fontFamily: 'inherit',
                                }}>Cancel</button>
                            </div>
                        </div>
                    </div>
                </div>
            )}

            {renameFolderTarget && (
                <div
                    role="dialog"
                    aria-modal="true"
                    style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.35)', display: 'flex', alignItems: 'center', justifyContent: 'center', zIndex: 50, padding: '16px' }}
                    onClick={closeRenameFolder}
                >
                    <div style={{ ...cardStyle, width: '100%', maxWidth: '360px' }} onClick={e => e.stopPropagation()}>
                        <div style={{ padding: '14px 18px', borderBottom: '1px solid #f5f5f5', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                            <span style={sectionTitle}>Rename folder</span>
                            <button type="button" onClick={closeRenameFolder} aria-label="Close" style={{ background: 'none', border: 'none', cursor: 'pointer', color: '#aaa', fontSize: '14px', lineHeight: 1 }}>&times;</button>
                        </div>
                        <div style={{ padding: '18px' }}>
                            <input
                                type="text"
                                value={renameFolderValue}
                                onChange={(e) => setRenameFolderValue(e.target.value)}
                                autoFocus
                                style={{ width: '100%', boxSizing: 'border-box', padding: '8px 10px', fontSize: '12.5px', border: '1px solid #ddd', borderRadius: '6px', marginBottom: '14px', fontFamily: 'inherit' }}
                            />
                            <div style={{ display: 'flex', gap: '8px' }}>
                                <button
                                    type="button"
                                    onClick={saveRenameFolder}
                                    disabled={renameFolderSaving || !renameFolderValue.trim()}
                                    style={{
                                        background: '#CC0000', color: 'white', border: 'none', borderRadius: '8px',
                                        padding: '9px 20px', fontSize: '11.5px', fontWeight: '600', fontFamily: 'inherit',
                                        cursor: (renameFolderSaving || !renameFolderValue.trim()) ? 'not-allowed' : 'pointer',
                                        opacity: (renameFolderSaving || !renameFolderValue.trim()) ? 0.6 : 1,
                                    }}
                                >
                                    {renameFolderSaving ? 'Saving...' : 'Save'}
                                </button>
                                <button type="button" onClick={closeRenameFolder} style={{
                                    background: 'white', color: '#666', border: '1px solid #ebebeb', borderRadius: '8px',
                                    padding: '9px 18px', fontSize: '11.5px', fontWeight: '500', cursor: 'pointer', fontFamily: 'inherit',
                                }}>Cancel</button>
                            </div>
                        </div>
                    </div>
                </div>
            )}

{false && selected.length > 0 && (() => {
    const itemStyle = {
        width: '100%', display: 'flex', alignItems: 'center', gap: '10px',
        padding: '11px 14px', background: 'none', border: 'none', fontSize: '13px',
        color: '#111', textAlign: 'left', cursor: 'pointer', fontFamily: 'inherit',
    };
    const selDocs = selected.filter(s => s.kind === 'doc').map(s => s.item);
    const allFiles = selectedAllFiles();
    const bw = 200;
    const barPos = barPoint.x === null
        ? { left: '50%', transform: 'translateX(-50%)', bottom: '18px' }
        : {
            left: Math.min(Math.max(barPoint.x - bw / 2, 12), window.innerWidth - bw - 12) + 'px',
            top: Math.min(barPoint.y + 14, window.innerHeight - 270) + 'px',
        };
    return (
        <div style={{ position: 'fixed', ...barPos, zIndex: 55, width: '200px', maxWidth: 'calc(100vw - 24px)', background: 'white', borderRadius: '10px', border: '1px solid #ebebeb', boxShadow: '0 4px 16px rgba(0,0,0,0.10)', overflow: 'hidden', maxHeight: '260px', display: 'flex', flexDirection: 'column' }}>
            {!barMoveOpen ? (
                <>
                    <div style={{ ...itemStyle, cursor: 'default', fontSize: '11px', color: '#888', borderBottom: '1px solid #f5f5f5' }}>
                        {selected.length} selected
                    </div>
                    <button type="button" style={{ ...itemStyle, opacity: allFiles.length ? 1 : 0.5 }} disabled={!allFiles.length} onClick={() => { downloadAllApprovedFiles(allFiles); clearSelection(); }}>
                        Download all
                    </button>
                    <button type="button" style={{ ...itemStyle, color: '#CC0000', opacity: allFiles.length ? 1 : 0.5 }} disabled={!allFiles.length} onClick={() => {
                        const ids = allFiles.map(f => f.id);
                        if (ids.length) setArchivePrompt({ name: ids.length + ' file' + (ids.length !== 1 ? 's' : ''), document_ids: ids });
                    }}>
                        Archive
                    </button>
                    {selDocs.length > 0 && (
                        <button type="button" style={itemStyle} onClick={() => { setClipboardDocs(selDocs); setClipboardDoc(null); setClipboardFolder(null); clearSelection(); }}>
                            Copy all
                        </button>
                    )}
                    <button type="button" style={itemStyle} onClick={() => setBarMoveOpen(true)}>
                        Move to folder
                    </button>
                </>
            ) : (
                <>
                    <button type="button" style={{ ...itemStyle, borderBottom: '1px solid #f5f5f5', fontWeight: 600 }} onClick={() => setBarMoveOpen(false)}>
                        Back
                    </button>
                    <div style={{ overflowY: 'auto' }}>
                        <button type="button" style={itemStyle} onClick={() => moveSelected('top')}>
                            Back to Approved / top-level
                        </button>
                        {folderOptions.map(o => (
                            <button key={o.id} type="button" style={itemStyle} onClick={() => moveSelected(o.id)}>
                                {o.name}
                            </button>
                        ))}
                    </div>
                </>
            )}
        </div>
    );
})()}

{actionMenu && (
    <div
        role="presentation"
        onClick={closeActionMenu}
        style={{ position: 'fixed', inset: 0, zIndex: 60, background: 'rgba(0,0,0,0.15)' }}
    >
        {(() => {
            const menuWidth = 200;
            const vw = window.innerWidth;
            const vh = window.innerHeight;
            const left = Math.min(Math.max(actionMenu.x - menuWidth / 2, 12), vw - menuWidth - 12);
            const top = Math.max(8, Math.min(actionMenu.y + 14, vh - 330));
            const itemStyle = {
                width: '100%', display: 'flex', alignItems: 'center', gap: '10px',
                padding: '11px 14px', background: 'none', border: 'none', fontSize: '13px',
                color: '#111', textAlign: 'left', cursor: 'pointer', fontFamily: 'inherit',
            };
            const moveList = actionMenu.kind === 'folder'
                ? folderOptions.filter(o => o.id !== actionMenu.item.id && !getDescendantFolderIds(actionMenu.item.id).includes(o.id))
                : (actionMenu.moveFolders || []);
            const dlHref = actionMenu.kind === 'file' ? approvedDownloadHref(actionMenu.item) : null;
            return (
                <div
                    onClick={(e) => e.stopPropagation()}
                    style={{
                        position: 'fixed', left: `${left}px`, top: `${top}px`, width: `${menuWidth}px`,
                        background: 'white', borderRadius: '10px', border: '1px solid #ebebeb',
                        overflow: 'hidden', maxHeight: '260px', display: 'flex', flexDirection: 'column',
                    }}
                >
{actionMenu.kind === 'multi' ? (
                        !moveSubmenuOpen ? (
                        <>
                            <div style={{ ...itemStyle, cursor: 'default', fontSize: '11px', color: '#888', borderBottom: '1px solid #f5f5f5' }}>
                                {selected.length} selected
                            </div>
                            <button type="button" style={itemStyle} onClick={() => { downloadAllApprovedFiles(selectedAllFiles()); clearSelection(); closeActionMenu(); }}>
                                <Ico n="download" />
                                Download all
                            </button>
                            {selected[0]?.section !== 'archive' && (<button type="button" style={{ ...itemStyle, color: '#CC0000' }} onClick={() => {
                                const ids = selectedAllFiles().map(f => f.id);
                                if (ids.length) setArchivePrompt({ name: ids.length + ' file' + (ids.length !== 1 ? 's' : ''), document_ids: ids });
                                closeActionMenu();
                            }}>
                                <Ico n="archive" />
                                Archive
                            </button>)}
                            {selected.some(s => s.kind === 'doc') && (
                                <button type="button" style={itemStyle} onClick={() => { setClipboardDocs(selected.filter(s => s.kind === 'doc').map(s => s.item)); setClipboardDoc(null); setClipboardFolder(null); clearSelection(); closeActionMenu(); }}>
                                    <Ico n="copy" />
                                    Copy all
                                </button>
                            )}
                            <button type="button" style={itemStyle} onClick={() => setMoveSubmenuOpen(true)}>
                                <Ico n="move" />
                                Move to folder
                            </button>
                        </>
                        ) : (
                        <>
                            <button type="button" style={{ ...itemStyle, borderBottom: '1px solid #f5f5f5', fontWeight: 600 }} onClick={() => setMoveSubmenuOpen(false)}>
                                <Ico n="back" />
                                Back
                            </button>
                            <div style={{ overflowY: 'auto' }}>
                                <button type="button" style={itemStyle} onClick={() => { moveSelected('top'); closeActionMenu(); }}>
                                    Back to Approved / top-level
                                </button>
                                {folderOptions.map(o => (
                                    <button key={o.id} type="button" style={itemStyle} onClick={() => { moveSelected(o.id); closeActionMenu(); }}>
                                        {o.name}
                                    </button>
                                ))}
                            </div>
                        </>
                        )
                    ) : !moveSubmenuOpen && actionMenu.kind === 'group' ? (
                        <>
                            <div style={{ ...itemStyle, cursor: 'default', fontSize: '11px', color: '#888', borderBottom: '1px solid #f5f5f5' }}>
                                {(actionMenu.files || []).length} file{(actionMenu.files || []).length !== 1 ? 's' : ''}
                            </div>
                            <button type="button" style={itemStyle} onClick={() => { downloadAllApprovedFiles(actionMenu.files); closeActionMenu(); }}>
                                <Ico n="download" />
                                Download all
                            </button>
                            <button type="button" style={itemStyle} onClick={() => { setClipboardDocs(actionMenu.files); setClipboardDoc(null); setClipboardFolder(null); closeActionMenu(); }}>
                                <Ico n="copy" />
                                Copy all
                            </button>
                            <button type="button" style={itemStyle} onClick={() => setMoveSubmenuOpen(true)}>
                                <Ico n="move" />
                                Move to folder
                            </button>
                        </>
                    ) : !moveSubmenuOpen ? (
                        <>
                            {actionMenu.kind === 'file' && dlHref && (
                                <a href={dlHref} download onClick={closeActionMenu} style={{ ...itemStyle, textDecoration: 'none' }}>
                                    <Ico n="download" />
                                    Download
                                </a>
                            )}
                            <button type="button" style={itemStyle} onClick={() => {
                                if (actionMenu.kind === 'folder') openRenameFolder(actionMenu.item);
                                else openRename(actionMenu.item);
                                closeActionMenu();
                            }}>
                                <Ico n="rename" />
                                Rename
                            </button>
                            {actionMenu.kind === 'folder' && (
                                <button type="button" style={itemStyle} onClick={() => {
                                    const ids = [actionMenu.item.id, ...getDescendantFolderIds(actionMenu.item.id)];
                                    downloadAllApprovedFiles(allIndividualFiles.filter(d => ids.includes(d.folder_id)));
                                    closeActionMenu();
                                }}>
                                    <Ico n="download" />
                                    Download all
                                </button>
                            )}
                            {!actionMenu.noStar && (
                            <button type="button" style={itemStyle} onClick={() => {
                                router.patch(route(actionMenu.kind === 'folder' ? 'volunteer.file201.folders.star' : 'volunteer.file201.documents.star', actionMenu.item.id), {}, { preserveScroll: true });
                                closeActionMenu();
                            }}>
                                <Ico n="star" />
                                {actionMenu.item.is_starred ? 'Remove from starred' : 'Add to starred'}
                            </button>
                            )}
                            {actionMenu.kind === 'file' && (
                                <button type="button" style={itemStyle} onClick={() => { setClipboardDoc(actionMenu.item); setClipboardDocs([]); closeActionMenu(); }}>
                                    <Ico n="copy" />
                                    Copy
                                </button>
                            )}
                            {actionMenu.kind === 'folder' && (
                                <button type="button" style={itemStyle} onClick={() => { setClipboardFolder(actionMenu.item); setClipboardDoc(null); setClipboardDocs([]); closeActionMenu(); }}>
                                    <Ico n="copy" />
                                    Copy
                                </button>
                            )}
                            {actionMenu.kind === 'folder' && clipboardFolder && actionMenu.item.id !== clipboardFolder.id && !getDescendantFolderIds(clipboardFolder.id).includes(actionMenu.item.id) && (
                                <button type="button" style={itemStyle} onClick={() => { pasteFolder(actionMenu.item.id); closeActionMenu(); }}>
                                    <Ico n="paste" />
                                    Paste folder "{clipboardFolder.name}"
                                </button>
                            )}
                            {actionMenu.kind === 'folder' && clipboardDoc && (
                                <button type="button" style={itemStyle} onClick={() => { pasteDoc(actionMenu.item.id); closeActionMenu(); }}>
                                    <Ico n="paste" />
                                    Paste "{clipboardDoc.original_name || clipboardDoc.name}"
                                </button>
                            )}
                            {actionMenu.kind === 'folder' && clipboardDocs.length > 0 && (
                                <button type="button" style={itemStyle} onClick={() => { pasteDocs(actionMenu.item.id); closeActionMenu(); }}>
                                    <Ico n="paste" />
                                    Paste {clipboardDocs.length} files
                                </button>
                            )}
                            {(actionMenu.kind === 'folder' || actionMenu.canMove) && (
                                <button type="button" style={itemStyle} onClick={() => setMoveSubmenuOpen(true)}>
                                    <Ico n="move" />
                                    Move to folder
                                </button>
                            )}
                            {actionMenu.kind === 'file' && (
                                <button type="button" style={{ ...itemStyle, color: '#CC0000' }} onClick={() => {
                                    setArchivePrompt({ name: actionMenu.item.original_name || actionMenu.item.name, document_ids: [actionMenu.item.id] });
                                    closeActionMenu();
                                }}>
                                    <Ico n="archive" />
                                    Archive
                                </button>
                            )}
                            {actionMenu.kind === 'file' && actionMenu.item.is_copy && (
                                <button type="button" style={{ ...itemStyle, color: '#CC0000' }} onClick={() => {
                                    const f = actionMenu.item;
                                    closeActionMenu();
                                    if (confirm("Delete this copy? This can't be undone.")) {
                                        router.delete(route('volunteer.file201.documents.destroy', f.id), { preserveScroll: true });
                                    }
                                }}>
                                    <Ico n="archive" />
                                    Delete copy
                                </button>
                            )}
                            {actionMenu.kind === 'folder' && (
                                <button type="button" style={{ ...itemStyle, color: '#CC0000' }} onClick={() => {
                                    handleDeleteFolder(actionMenu.item);
                                    closeActionMenu();
                                }}>
                                    <Ico n="archive" />
                                    Archive
                                </button>
                            )}
                        </>
                    ) : (
                        <>
                            <button type="button" style={{ ...itemStyle, borderBottom: '1px solid #f5f5f5', fontWeight: 600 }} onClick={() => setMoveSubmenuOpen(false)}>
                                <Ico n="back" />
                                Back
                            </button>
                            <div style={{ overflowY: 'auto' }}>
                                {moveList.length > 0 && (
                                <button type="button" style={itemStyle} onClick={() => {
                                    if (actionMenu.kind === 'folder') moveFolder(actionMenu.item, '');
                                    else if (actionMenu.kind === 'group') moveGroupSeq(actionMenu.files, ''); else moveDoc(actionMenu.item, '');
                                    closeActionMenu();
                                }}>
                                    {actionMenu.kind === 'folder' ? 'Make top-level (no parent)' : 'Back to Approved'}
                                </button>
                                )}
                                {moveList.length === 0 ? (
                                    <div style={{ padding: '11px 14px', fontSize: '11.5px', color: '#aaa' }}>Create a folder first.</div>
                                ) : moveList.map(o => (
                                    <button key={o.id} type="button" style={itemStyle} onClick={() => {
                                        if (actionMenu.kind === 'folder') moveFolder(actionMenu.item, o.id);
                                        else if (actionMenu.kind === 'group') moveGroupSeq(actionMenu.files, o.id); else moveDoc(actionMenu.item, o.id);
                                        closeActionMenu();
                                    }}>
                                        {o.name}
                                    </button>
                                ))}
                            </div>
                        </>
                    )}
                </div>
            );
        })()}
    </div>
)}

        </VolunteerShell>
    );
}

/* ---------------- Shared pieces ---------------- */

function ChevronIcon({ open }) {
    return (
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"
            style={{ color: '#aaa', transition: 'transform .18s ease', transform: open ? 'rotate(180deg)' : 'none', flexShrink: 0 }}>
            <polyline points="6 9 12 15 18 9" />
        </svg>
    );
}

function Field({ label, value, last }) {
    return (
        <div style={{ padding: '8px 0', borderBottom: last ? 'none' : '1px solid #f5f5f5' }}>
            <div style={{ fontSize: '9.5px', fontWeight: 600, color: '#aaa', textTransform: 'uppercase', letterSpacing: '0.3px' }}>{label}</div>
            <div style={{ fontSize: '12px', color: '#111', marginTop: '2px' }}>{value}</div>
        </div>
    );
}

function StatusTabButton({ active, onClick, label, count, activeColor = '#CC0000' }) {
    return (
        <button
            type="button"
            onClick={onClick}
            style={{
                display: 'flex', alignItems: 'center', gap: '6px',
                padding: '7px 14px', borderRadius: '20px', fontFamily: 'inherit',
                fontSize: '11.5px', fontWeight: '600', cursor: 'pointer',
                border: active ? `1px solid ${activeColor}` : '1px solid #ebebeb',
                background: active ? activeColor : 'white',
                color: active ? 'white' : '#666',
            }}
        >
            {label}
            <span style={{
                fontSize: '10px', fontWeight: '700', borderRadius: '10px', padding: '1px 7px',
                background: active ? 'rgba(255,255,255,0.25)' : '#f5f5f5',
                color: active ? 'white' : '#999',
            }}>{count}</span>
        </button>
    );
}

function MoveSelect({ folders, value, onChange, placeholder, allowUnfile = false, unfileLabel = 'Back to Approved', style }) {
    const noFolders = folders.length === 0 && !allowUnfile;
    return (
        <select
            className="vp-input"
            value={value}
            onClick={(e) => e.stopPropagation()}
            onChange={(e) => onChange(e.target.value)}
            aria-label="Move to folder"
            disabled={noFolders}
            title={noFolders ? 'Create a folder first' : undefined}
            style={{ ...style, padding: '5px 8px', fontSize: '11px', minWidth: '130px', width: 'auto' }}
        >
            <option value="" disabled={!allowUnfile}>{noFolders ? 'Create a folder first' : placeholder}</option>
            {allowUnfile && <option value="">{unfileLabel}</option>}
            {folders.map(f => <option key={f.id} value={f.id}>{f.name}</option>)}
        </select>
    );
}

function DataTable({ cardStyle, columns, rows, keys, empty, rowOnClick, rowExtraProps }) {
    if (rows.length === 0) {
        return (
            <div style={{ ...cardStyle, padding: '40px 20px', textAlign: 'center' }}>
                <div style={{ width: '44px', height: '44px', borderRadius: '10px', background: '#f5f5f5', display: 'flex', alignItems: 'center', justifyContent: 'center', margin: '0 auto 12px' }}>
                    <FileIcon color="#ccc" size={20} />
                </div>
                <div style={{ fontSize: '11.5px', color: '#aaa' }}>{empty}</div>
            </div>
        );
    }

    return (
        <div style={cardStyle}>
            <div style={{ overflowX: 'auto' }}>
                <table style={{ width: '100%', borderCollapse: 'collapse', minWidth: '560px' }}>
                    <thead>
                        <tr style={{ background: '#fafafa', borderBottom: '1px solid #f0f0f0' }}>
                            {columns.map(c => (
                                <th key={c} style={{ textAlign: 'left', padding: '10px 16px', fontSize: '10px', fontWeight: '600', color: '#aaa', textTransform: 'uppercase', letterSpacing: '0.3px', whiteSpace: 'nowrap' }}>
                                    {c}
                                </th>
                            ))}
                        </tr>
                    </thead>
                    <tbody>
                        {rows.map((cells, i) => {
                            const onRowClick = rowOnClick && rowOnClick[i];
                            return (
                                <tr
                                    key={keys[i] ?? i}
                                    className="f201-row"
                                    onClick={onRowClick || undefined}
                                    {...(rowExtraProps && rowExtraProps[i] ? rowExtraProps[i] : {})}
                                    style={{
                                        borderBottom: i < rows.length - 1 ? '1px solid #f5f5f5' : 'none',
                                        cursor: onRowClick ? 'pointer' : 'default',
                                    }}
                                >
                                    {cells.map((cell, j) => (
                                        <td key={j} style={{ padding: '12px 16px', fontSize: '12px', color: '#555', verticalAlign: 'top', lineHeight: '1.5' }}>
                                            {cell}
                                        </td>
                                    ))}
                                </tr>
                            );
                        })}
                    </tbody>
                </table>
            </div>
        </div>
    );
}

/* Document name -- clickable straight to the protected view route when a file exists. */
function FileNameLink({ doc }) {
    const displayName = doc.original_name || doc.name;
    const href = approvedViewHref(doc);
    if (!href) return <strong style={{ color: '#111', fontWeight: 600, fontSize: '12.5px' }}>{displayName}</strong>;
    return (
        <a
            href={href}
            target="_blank"
            rel="noreferrer"
            className="f201-name-link"
            onClick={(e) => e.preventDefault()}
            style={{ color: '#111', fontWeight: 600, fontSize: '12.5px', textDecoration: 'none' }}
        >
            {displayName}
        </a>
    );
}

/* Small icon-only download button. Shows a dash when the record has no file yet. */
function DownloadButton({ href }) {
    if (!href) return <span style={{ color: '#ccc' }}>-</span>;
    return (
        <a
            href={href}
            download
            title="Download"
            className="f201-icon-btn"
            onClick={(e) => e.stopPropagation()}
            style={{
                display: 'inline-flex', alignItems: 'center', justifyContent: 'center',
                width: '28px', height: '28px', borderRadius: '6px', border: '1px solid #e0e0e0',
                color: '#333', textDecoration: 'none',
            }}
        >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
        </a>
    );
}

/* Small icon-only rename button. Opens the rename dialog for a given file. */
function RenameButton({ doc, onRename }) {
    return (
        <button
            type="button"
            title="Rename"
            className="f201-icon-btn"
            onClick={(e) => { e.stopPropagation(); onRename(doc); }}
            style={{
                display: 'inline-flex', alignItems: 'center', justifyContent: 'center',
                width: '28px', height: '28px', borderRadius: '6px', border: '1px solid #e0e0e0',
                color: '#333', background: 'white', cursor: 'pointer',
            }}
        >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
        </button>
    );
}

function FileIcon({ color = '#aaa', size = 16 }) {
    return (
        <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke={color} strokeWidth="1.8" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
        </svg>
    );
}

function FolderIcon({ color = '#aaa', size = 16 }) {
    return (
        <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke={color} strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
        </svg>
    );
}

function Ico({ n }) {
    const P = {
        download: <><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></>,
