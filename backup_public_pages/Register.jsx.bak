import { Head, Link, useForm } from '@inertiajs/react';
import { useState } from 'react';

export default function Register() {
    const [showPassword, setShowPassword] = useState(false);
    const [showConfirm, setShowConfirm] = useState(false);

    const { data, setData, post, processing, errors } = useForm({
        name: '',
        email: '',
        password: '',
        password_confirmation: '',
    });

    const submit = (e) => {
        e.preventDefault();
        post(route('register'));
    };

    const navItems = [
        {
            label: 'Home', href: '/',
            children: [
                { label: 'Welcome', href: '/' },
                { label: 'Latest News', href: '/#latest-news' },
                { label: 'Recent Programs', href: '/#recent-programs' },
            ]
        },
        {
            label: 'About Us', href: route('about'),
            children: [
                { label: 'Who We Are', href: route('about') + '#who-we-are' },
                { label: 'Mission & Vision', href: route('about') + '#mission-vision' },
                { label: 'Our Team', href: route('about') + '#our-team' },
                { label: 'Our Services', href: route('about') + '#our-services' },
            ]
        },
        {
            label: 'Volunteer', href: route('volunteer'),
            children: [
                { label: 'Become a Volunteer', href: `${route('volunteer')}#become` },
                { label: 'Red Cross 143 Program', href: `${route('volunteer')}#program` },
                { label: 'Volunteer Service FAQs', href: `${route('volunteer')}#faqs` },
            ]
        },
        {
            label: 'Contact Us', href: route('contact'),
            children: [
                { label: 'Get in Touch', href: route('contact') + '#get-in-touch' },
                { label: 'Find Us', href: route('contact') + '#find-us' },
                { label: 'Emergency Hotlines', href: route('contact') + '#emergency-hotlines' },
            ]
        },
    ];

    const eyeIcon = (visible) => visible ? (
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round">
            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" />
            <line x1="1" y1="1" x2="23" y2="23" />
        </svg>
    ) : (
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
            <circle cx="12" cy="12" r="3" />
        </svg>
    );

    const userIcon = (
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
        </svg>
    );

    const mailIcon = (
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <path d="m22 7-10 6L2 7" />
        </svg>
    );

    const lockIcon = (
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
        </svg>
    );

    const labelStyle = {
        display: 'block', fontSize: '9px',
        fontWeight: '600', color: '#999', marginBottom: '3px',
        textTransform: 'uppercase', letterSpacing: '0.6px',
        fontFamily: 'Source Sans 3, sans-serif',
    };

    const errorStyle = { fontSize: '10px', color: '#DC2626', marginTop: '4px', fontFamily: 'Source Sans 3, sans-serif' };

    return (
        <>
            <Head title="Volunteer Registration" />
            <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Montserrat:wght@400;500;600;700&family=Source+Sans+3:ital,wght@0,300;0,400;0,600;1,300&family=Open+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet" />

            <style>{`
                *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

                body {
                    font-family: 'Source Sans 3', sans-serif;
                    background: linear-gradient(135deg, #fff5f5 0%, #fee2e2 100%);
                    background-attachment: fixed;
                    min-height: 100vh;
                }

                /* ── NAVBAR (matches Welcome page) ── */
                .nav-pill-red {
                    display: flex; align-items: center; gap: 2px;
                    background: transparent;
                    border-radius: 100px; padding: 4px;
                    list-style: none; margin: 0;
                }
                .nav-item-red { position: relative; }
                .nav-link-red {
                    font-family: 'Open Sans', sans-serif;
                    font-size: 12.5px; font-weight: 600;
                    color: #7f1d1d;
                    padding: 7px 16px;
                    display: inline-block; white-space: nowrap;
                    cursor: pointer;
                    position: relative;
                    text-decoration: none;
                    transition: color 0.2s;
                }
                .nav-link-red:hover { color: #DC2626; }
                .nav-link-red.active { color: #DC2626; }
                .nav-link-red.active::after {
                    content: ''; position: absolute; left: 16px; right: 16px; bottom: -2px;
                    height: 2px; background: #DC2626; border-radius: 2px;
                }

                .nav-auth { display: flex; align-items: center; gap: 8px; }
                .nav-login-link {
                    font-family: 'Open Sans', sans-serif;
                    font-size: 12.5px; font-weight: 600;
                    color: #7f1d1d; padding: 8px 16px;
                    border-radius: 100px;
                    text-decoration: none; white-space: nowrap;
                    transition: background 0.2s;
                }
                .nav-login-link:hover { background: #fee2e2; }
                .login-btn-red {
                    font-family: 'Open Sans', sans-serif;
                    font-size: 12.5px; font-weight: 700;
                    color: white; padding: 8px 18px;
                    border-radius: 100px;
                    background: #DC2626;
                    text-decoration: none; white-space: nowrap;
                    transition: background 0.2s;
                }
                .login-btn-red:hover { background: #b91c1c; }

                .reg-input {
                    width: 100%; padding: 7px 12px;
                    border-radius: 10px; font-size: 12px;
                    outline: none; color: #111;
                    background: #fff3f3; box-sizing: border-box;
                    font-family: 'Source Sans 3', sans-serif;
                    transition: border 0.15s;
                }
                .reg-input:focus { border-color: #DC2626 !important; box-shadow: 0 0 0 3px rgba(220,38,38,0.08); }

                /* Hide native browser password reveal/clear icons (Edge/IE) so they don't double up with our custom eye toggle */
                input[type="password"]::-ms-reveal,
                input[type="password"]::-ms-clear {
                    display: none;
                }
                input::-webkit-credentials-auto-fill-button,
                input::-webkit-strong-password-auto-fill-button {
                    display: none !important;
                    visibility: hidden;
                    pointer-events: none;
                    position: absolute;
                    right: 0;
                }

                .password-toggle-btn {
                    position: absolute; right: 4px; top: 50%;
                    transform: translateY(-50%);
                    background: none; border: none; cursor: pointer;
                    padding: 6px; display: flex; align-items: center;
                    justify-content: center; color: #aaa;
                    transition: color 0.15s;
                }
                .password-toggle-btn:hover { color: #DC2626; }

                .reg-submit-btn {
                    width: 100%; padding: 8px;
                    color: white; border: none;
                    border-radius: 100px; font-size: 12.5px;
                    font-weight: 600; letter-spacing: 0.4px;
                    font-family: 'Source Sans 3', sans-serif;
                    box-shadow: 0 8px 18px rgba(220,38,38,0.22);
                    transition: opacity 0.2s;
                }
                .reg-submit-btn:hover:not(:disabled) { opacity: 0.9; }

                /* ── FIELD ICONS ── */
                .field-wrap { position: relative; }
                .field-icon {
                    position: absolute; left: 12px; top: 50%;
                    transform: translateY(-50%);
                    color: #c9a3a3; display: flex; pointer-events: none;
                }
                .reg-input.with-icon { padding-left: 36px; }

                /* ── OR DIVIDER + GOOGLE ── */
                .divider-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
                .divider-row div { flex: 1; height: 1px; background: #ffe2e2; }
                .divider-row span { font-size: 10px; color: #bbb; font-family: 'Open Sans', sans-serif; }

                .google-btn {
                    width: 100%; padding: 7px 12px;
                    display: flex; align-items: center; justify-content: center; gap: 8px;
                    background: white; border: 1px solid #ffe2e2;
                    border-radius: 100px; cursor: pointer;
                    color: #444; font-size: 12px; font-weight: 600;
                    font-family: 'Open Sans', sans-serif;
                    transition: background 0.15s, border-color 0.15s;
                }
                .google-btn:hover { background: #fff3f3; border-color: #fca5a5; }

                /* mobile text sizes */
                @media (max-width: 1024px) {
                    [style*="max-width: 360px"] { max-width: 440px !important; padding: 28px 28px !important; }
                    [style*="width: 40px"] { width: 56px !important; height: 56px !important; }
                    [style*="font-size: 21px"] { font-size: 28px !important; }
                    [style*="font-size: 11.5px"] { font-size: 15px !important; }
                    [style*="font-size: 9px"] { font-size: 12px !important; }
                    [style*="font-size: 9.5px"] { font-size: 13px !important; }
                    [style*="font-size: 10px"] { font-size: 13px !important; }
                    [style*="font-size: 11px"] { font-size: 14px !important; }
                    [style*="padding-right: 34px"] { padding-right: 46px !important; }
                    .reg-input { font-size: 16px !important; padding-top: 12px !important; padding-bottom: 12px !important; }
                    .reg-input.with-icon { padding-left: 44px !important; }
                    .reg-submit-btn { font-size: 16px !important; padding: 13px !important; }
                    .google-btn { font-size: 15px !important; padding: 12px !important; }
                    .divider-row span { font-size: 12px !important; }
                    .field-icon svg { width: 18px !important; height: 18px !important; }
                    .password-toggle-btn svg { width: 20px !important; height: 20px !important; }
                    .google-btn svg { width: 18px !important; height: 18px !important; }
                }
                @media (max-width: 640px) {
                    [style*="gap: 10px"] { flex-direction: column !important; gap: 8px !important; }
                    [style*="gap: 10px"] > div { flex: none !important; width: 100% !important; }
                }
            `}</style>

            <div>

                

                {/* ── CENTERED REGISTER ── */}
                <div style={{
                    minHeight: '100vh', display: 'flex',
                    flexDirection: 'column',
                    justifyContent: 'center', alignItems: 'center',
                    padding: '24px 16px',
                }}>
                    <div style={{
                        width: '100%', maxWidth: '360px',
                        background: 'white', borderRadius: '18px',
                        padding: '18px 24px',
                        boxShadow: '0 8px 30px rgba(127,29,29,0.08)',
                        border: '1px solid #f5f5f5',
                    }}>

                        {/* Logo */}
                        <div style={{ display: 'flex', justifyContent: 'center', marginBottom: '8px' }}>
                            <div style={{
                                width: '40px', height: '40px', background: 'white',
                                borderRadius: '50%', overflow: 'hidden',
                                display: 'flex', alignItems: 'center', justifyContent: 'center',
                                boxShadow: '0 6px 18px rgba(127,29,29,0.14)',
                                border: '1px solid #ffe2e2',
                            }}>
                                <img
                                    src="/images/red-cross-logo.png"
                                    alt="Philippine Red Cross"
                                    style={{ width: '100%', height: '100%', objectFit: 'cover' }}
                                />
                            </div>
                        </div>

                        {/* Title */}
                        <div style={{ marginBottom: '18px', textAlign: 'center' }}>
                            <div style={{
                                fontFamily: "'Open Sans', sans-serif",
                                fontSize: '21px', fontWeight: '700',
                                letterSpacing: '0.2px', textTransform: 'none',
                                color: '#1a1a1a', marginBottom: '3px', lineHeight: 1.2,
                            }}>
                                Create <span style={{ color: '#DC2626' }}>account!</span>
                            </div>
                            <p style={{ fontSize: '11.5px', color: '#999', fontWeight: '400', fontFamily: "'Open Sans', sans-serif" }}>
                                Register to join the Red Cross volunteer team
                            </p>
                        </div>

                        {/* Form */}
                        <form onSubmit={submit}>

                            {/* Full Name */}
                            <div style={{ marginBottom: '8px' }}>
                                <label style={labelStyle}>Full Name</label>
                                <div className="field-wrap">
                                    <span className="field-icon">{userIcon}</span>
                                    <input
                                        type="text"
                                        value={data.name}
                                        onChange={e => setData('name', e.target.value)}
                                        placeholder="Enter your full name"
                                        required
                                        className="reg-input with-icon"
                                        style={{ border: errors.name ? '1px solid #DC2626' : '1px solid #ffe2e2' }}
                                    />
                                </div>
                                {errors.name && <p style={errorStyle}>{errors.name}</p>}
                            </div>

                            {/* Email */}
                            <div style={{ marginBottom: '8px' }}>
                                <label style={labelStyle}>Email Address</label>
                                <div className="field-wrap">
                                    <span className="field-icon">{mailIcon}</span>
                                    <input
                                        type="email"
                                        value={data.email}
                                        onChange={e => setData('email', e.target.value)}
                                        placeholder="Enter your email"
                                        required
                                        className="reg-input with-icon"
                                        style={{ border: errors.email ? '1px solid #DC2626' : '1px solid #ffe2e2' }}
                                    />
                                </div>
                                {errors.email && <p style={errorStyle}>{errors.email}</p>}
                            </div>

                            {/* Password + Confirm Password (same line) */}
                            <div style={{ display: 'flex', gap: '10px', marginBottom: '10px' }}>
                                <div style={{ flex: 1, minWidth: 0 }}>
                                    <label style={labelStyle}>Password</label>
                                    <div className="field-wrap">
                                        <input
                                            type={showPassword ? 'text' : 'password'}
                                            value={data.password}
                                            onChange={e => setData('password', e.target.value)}
                                            placeholder="Create password"
                                            required
                                            className="reg-input"
                                            style={{
                                                border: errors.password ? '1px solid #DC2626' : '1px solid #ffe2e2',
                                                paddingRight: '34px',
                                            }}
                                        />
                                        <button
                                            type="button"
                                            onClick={() => setShowPassword(!showPassword)}
                                            className="password-toggle-btn"
                                            tabIndex={-1}
                                            aria-label={showPassword ? 'Hide password' : 'Show password'}
                                        >
                                            {eyeIcon(showPassword)}
                                        </button>
                                    </div>
                                    {errors.password && <p style={{ ...errorStyle, fontSize: '9.5px' }}>{errors.password}</p>}
                                </div>

                                <div style={{ flex: 1, minWidth: 0 }}>
                                    <label style={labelStyle}>Confirm Password</label>
                                    <div className="field-wrap">
                                        <input
                                            type={showConfirm ? 'text' : 'password'}
                                            value={data.password_confirmation}
                                            onChange={e => setData('password_confirmation', e.target.value)}
                                            placeholder="Repeat password"
                                            required
                                            className="reg-input"
                                            style={{
                                                border: errors.password_confirmation ? '1px solid #DC2626' : '1px solid #ffe2e2',
                                                paddingRight: '34px',
                                            }}
                                        />
                                        <button
                                            type="button"
                                            onClick={() => setShowConfirm(!showConfirm)}
                                            className="password-toggle-btn"
                                            tabIndex={-1}
                                            aria-label={showConfirm ? 'Hide password' : 'Show password'}
                                        >
                                            {eyeIcon(showConfirm)}
                                        </button>
                                    </div>
                                    {errors.password_confirmation && <p style={{ ...errorStyle, fontSize: '9.5px' }}>{errors.password_confirmation}</p>}
                                </div>
                            </div>

                            {/* Submit */}
                            <button
                                type="submit"
                                disabled={processing}
                                className="reg-submit-btn"
                                style={{
                                    background: processing ? '#f87171' : '#DC2626',
                                    cursor: processing ? 'not-allowed' : 'pointer',
                                    marginBottom: '10px',
                                }}
                            >
                                {processing ? 'Registering...' : 'Register as Volunteer'}
                            </button>

                            {/* Divider */}
                            <div className="divider-row">
                                <div />
                                <span>OR</span>
                                <div />
                            </div>

                            {/* Google only */}
                            <button
                                type="button"
                                className="google-btn"
                                style={{ marginBottom: '10px' }}
                                onClick={() => { /* TODO: window.location.href = route('auth.google') */ }}
                            >
                                <svg width="14" height="14" viewBox="0 0 48 48">
                                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                                </svg>
                                Continue with Google
                            </button>

                            <p style={{ textAlign: 'center', fontSize: '11px', color: '#999', fontFamily: 'Source Sans 3, sans-serif', fontWeight: '300' }}>
                                Already have an account?{' '}
                                <Link href={route('login')} style={{ color: '#DC2626', fontWeight: '600', textDecoration: 'none' }}>
                                    Log in here
                                </Link>
                            </p>
                        </form>
                    </div>
                </div>
            </div>
        </>
    );
}
